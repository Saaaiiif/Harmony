<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" styleClass="main-root-light" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.JournalExercicesController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="1080.0" style="-fx-background-color: #6a1b9a;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding><Insets left="20.0" right="20.0" /></padding>
            <children>
                <Label text="Harmony" textFill="WHITE"><font><Font name="System Bold" size="20.0" /></font></Label>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="15.0">
                    <Button onAction="#goToAccueil" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;" text="Accueil" />
                    <Button onAction="#goToAliments" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;" text="Aliments" />
                    <Button onAction="#goToExercices" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 20; -fx-padding: 5 15; -fx-cursor: hand;" text="Exercices" />
                    <Button onAction="#goToSommeil" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;" text="Sommeil" />
                </HBox>
            </children>
        </HBox>

        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox spacing="35.0" alignment="TOP_CENTER" style="-fx-background-color: transparent;">
                    <padding><Insets bottom="60.0" left="50.0" right="50.0" top="40.0" /></padding>
                    <children>
                        <VBox alignment="CENTER" spacing="5.0">
                            <Label text="⚡ Journal Sportif" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4a148c;" />
                            <Label text="Ajoutez vos séances, suivez votre évolution et dépassez vos limites." style="-fx-text-fill: #8e24aa; -fx-font-size: 16px; -fx-font-weight: bold;" />
                        </VBox>



                        <HBox alignment="CENTER" maxWidth="1000" spacing="30.0">
                            <VBox styleClass="card-innovative, card-cardio" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" onMouseClicked="#ajouterCardio">
                                <Label text="🫀" styleClass="card-icon" />
                                <Label text="Nouvelle Séance Cardio" styleClass="card-title" />
                                <Label text="Améliorez votre endurance et votre souffle." styleClass="card-desc" wrapText="true"/>
                            </VBox>
                            <VBox styleClass="card-innovative, card-muscu" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" onMouseClicked="#ajouterMusculation">
                                <Label text="🏋" styleClass="card-icon" />
                                <Label text="Nouvelle Séance Musculation" styleClass="card-title" />
                                <Label text="Développez votre volume et votre puissance." styleClass="card-desc" wrapText="true"/>
                            </VBox>
                        </HBox>

                        <Separator maxWidth="1000" style="-fx-opacity: 0.2; -fx-background-color: #aa00ff;"/>

                        <VBox alignment="CENTER_LEFT" maxWidth="1000" spacing="15.0">
                            <Label text="🗓️ Timeline de vos Entraînements" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3a0a52;" />
                            <Label text="Vos performances passées, affichées sous forme de modules d'intelligence." style="-fx-text-fill: #8e24aa; -fx-font-size: 15px;" />
                            <FlowPane fx:id="flowPaneHistorique" hgap="35.0" vgap="35.0" alignment="TOP_LEFT" />
                        </VBox>

                    </children>
                </VBox>
            </ScrollPane>

            <StackPane fx:id="overlayPane" visible="false" style="-fx-background-color: rgba(0,0,0,0.6);" />
        </StackPane>
    </children>
</AnchorPane>