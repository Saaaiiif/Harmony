<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.harmony.CalendarViewController"
      styleClass="calendar-view"
      spacing="16"
      prefWidth="900" prefHeight="500">

    <TabPane fx:id="mainTabPane" styleClass="calendar-tab-pane">
        <!-- Onglet Événements -->
        <Tab text="Événements" closable="false">
            <VBox spacing="12">
                <HBox alignment="CENTER_LEFT" styleClass="calendar-header">
                    <Label text="Événements" styleClass="calendar-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="calendar-actions">
                        <Button text="Ajouter" styleClass="btn-calendar btn-add" onAction="#onAjouter"/>
                        <Button text="Modifier" styleClass="btn-calendar btn-edit" onAction="#onModifier"/>
                        <Button text="Supprimer" styleClass="btn-calendar btn-delete" onAction="#onSupprimer"/>
                        <Button text="Consulter" styleClass="btn-calendar btn-view" onAction="#onConsulter"/>
                    </HBox>
                </HBox>
                <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS" styleClass="events-table">
                    <columns>
                        <TableColumn fx:id="colId" text="Id" prefWidth="50"/>
                        <TableColumn fx:id="colTitre" text="Titre" prefWidth="120"/>
                        <TableColumn fx:id="colDescription" text="Description" prefWidth="150"/>
                        <TableColumn fx:id="colDateDebut" text="Date début" prefWidth="100"/>
                        <TableColumn fx:id="colDateFin" text="Date fin" prefWidth="100"/>
                        <TableColumn fx:id="colLieu" text="Lieu" prefWidth="100"/>
                        <TableColumn fx:id="colPriorite" text="Priorité" prefWidth="70"/>
                        <TableColumn fx:id="colRappel" text="Rappel" prefWidth="60"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- Onglet Tâches -->
        <Tab text="Tâches" closable="false">
            <VBox spacing="12">
                <HBox alignment="CENTER_LEFT" styleClass="calendar-header">
                    <Label text="Tâches" styleClass="calendar-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="calendar-actions">
                        <Button text="Ajouter" styleClass="btn-calendar btn-add" onAction="#onAjouterTache"/>
                        <Button text="Modifier" styleClass="btn-calendar btn-edit" onAction="#onModifierTache"/>
                        <Button text="Supprimer" styleClass="btn-calendar btn-delete" onAction="#onSupprimerTache"/>
                        <Button text="Consulter" styleClass="btn-calendar btn-view" onAction="#onConsulterTache"/>
                    </HBox>
                </HBox>
                <TableView fx:id="tacheTable" VBox.vgrow="ALWAYS" styleClass="events-table">
                    <columns>
                        <TableColumn fx:id="colTacheId" text="Id" prefWidth="50"/>
                        <TableColumn fx:id="colTacheNom" text="Nom" prefWidth="180"/>
                        <TableColumn fx:id="colTacheDeadline" text="Deadline" prefWidth="100"/>
                        <TableColumn fx:id="colTacheStatut" text="Statut" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
</VBox>
