<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.harmony.CalendarFullViewController"
      styleClass="calendar-full-view"
      spacing="20"
      prefWidth="1000" prefHeight="700">

    <Label text="Calendrier - Tous les événements" styleClass="calendar-title" VBox.vgrow="NEVER"/>

    <ScrollPane styleClass="calendar-scroll" VBox.vgrow="ALWAYS" fitToWidth="true">
        <VBox fx:id="eventsContainer" spacing="15" styleClass="events-container"/>
    </ScrollPane>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
</VBox>
