<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane fx:id="mainContainer" prefHeight="720.0" prefWidth="1080.0" styleClass="main-root-light" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.JournalExercicesController">
    <children>
        <Region fx:id="bgTint" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

        <HBox fx:id="navbar" alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="1080.0" style="-fx-background-color: #6a1b9a;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding><Insets left="20.0" right="20.0" /></padding>
            <children>
                <Label text="Harmony" textFill="WHITE"><font><Font name="System Bold" size="20.0" /></font></Label>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="15.0">
                    <Button onAction="#goToAccueil" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;" text="Accueil" />
                    <Button onAction="#goToAliments" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;" text="Nutrition" />
                    <Button style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 20; -fx-padding: 5 15;" text="Exercices" />
                    <Button onAction="#goToSommeil" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;" text="Sommeil" />
                </HBox>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
            <content>
                <VBox alignment="TOP_CENTER" spacing="30.0" style="-fx-padding: 30; -fx-background-color: transparent;">

                    <VBox alignment="CENTER" spacing="20.0">
                        <Label text="Journal Exercices" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #4a148c; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 3);" />

                        <HBox style="-fx-background-color: rgba(255,255,255,0.8); -fx-background-radius: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 15, 0, 0, 5); -fx-padding: 5;" alignment="CENTER" maxWidth="380">
                            <Button fx:id="btnFemme" text="👩 Section Femme" onAction="#actionSetModeFemme" style="-fx-background-radius: 25; -fx-padding: 12 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" />
                            <Button fx:id="btnHomme" text="👨 Section Homme" onAction="#actionSetModeHomme" style="-fx-background-radius: 25; -fx-padding: 12 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" />
                        </HBox>

                        <HBox alignment="CENTER" spacing="10">
                            <Label text="📅 Date :" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                            <DatePicker fx:id="datePickerSeance" style="-fx-font-size: 14px; -fx-background-radius: 10; -fx-border-color: #6a1b9a; -fx-border-radius: 10; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>

                    <VBox spacing="15" alignment="CENTER">
                        <Label text="🎯 Objectif de la séance" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                        <ScrollPane vbarPolicy="NEVER" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 10;">
                            <HBox fx:id="hboxCategories" spacing="25" alignment="CENTER" style="-fx-padding: 10;"/>
                        </ScrollPane>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" style="-fx-padding: 0 20 0 20;">
                        <FlowPane fx:id="flowPaneExercices" hgap="25" vgap="25" alignment="CENTER" />
                    </VBox>

                    <Separator style="-fx-padding: 20 0;" />

                    <VBox spacing="20" alignment="CENTER">
                        <Label text="🏆 Mon Historique &amp; Mes Séances" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4a148c;" />
                        <FlowPane fx:id="flowPaneHistorique" hgap="30.0" vgap="30.0" alignment="CENTER" />
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>