<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" styleClass="main-root-light" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.GestionNutritionController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets top="30.0" right="40.0" bottom="20.0" left="40.0"/>
            </padding>
            <children>

                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="🍏 Bibliothèque Nutritionnelle" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4a148c;" />
                    <Label text="Ajoutez et gérez les aliments de la base de données avec précision." style="-fx-text-fill: #8e24aa; -fx-font-size: 16px; -fx-font-weight: bold;" />
                </VBox>

                <VBox alignment="CENTER" spacing="15" styleClass="glass-form-box" maxWidth="950">
                    <HBox alignment="CENTER" spacing="15.0">
                        <TextField fx:id="nomField" prefWidth="250.0" promptText="🍎 Nom de l'aliment (ex: Banane)" styleClass="neon-input-small" />
                        <TextField fx:id="caloriesField" prefWidth="120.0" promptText="🔥 Calories" styleClass="neon-input-small" />
                        <TextField fx:id="proteinesField" prefWidth="120.0" promptText="🥩 Prot (g)" styleClass="neon-input-small" />
                        <TextField fx:id="glucidesField" prefWidth="120.0" promptText="🍞 Glu (g)" styleClass="neon-input-small" />
                        <TextField fx:id="lipidesField" prefWidth="120.0" promptText="🥑 Lip (g)" styleClass="neon-input-small" />

                        <Button mnemonicParsing="false" onAction="#ajouterAliment" text="➕ Ajouter" styleClass="btn-neon-action" />
                    </HBox>
                    <Label fx:id="messageLabel" text="" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                </VBox>

                <ScrollPane fitToWidth="true" styleClass="transparent-scroll-pane" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="cardsContainer" hgap="25.0" vgap="25.0" alignment="TOP_CENTER">
                            <padding>
                                <Insets top="10.0" bottom="30.0" left="10.0" right="10.0" />
                            </padding>
                        </FlowPane>
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </children>
</AnchorPane>