<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" styleClass="main-root-light" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.GestionSportController">

    <fx:define>
        <ToggleGroup fx:id="filterGroupSexe" />
        <ToggleGroup fx:id="filterGroupType" />
    </fx:define>

    <children>
        <VBox alignment="TOP_CENTER" spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding><Insets top="30.0" right="40.0" bottom="20.0" left="40.0"/></padding>
            <children>

                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="⚡ Bibliothèque Sportive (Admin)" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4a148c;" />
                    <Label text="Gérez vos exercices, utilisez les filtres croisés et le CRUD innovant." style="-fx-font-size: 16px; -fx-text-fill: #666666;" />
                </VBox>

                <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <TextField fx:id="searchField" promptText="🔍 Rechercher un exercice..." style="-fx-font-size: 14px; -fx-pref-width: 300; -fx-background-radius: 20; -fx-padding: 8 15;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#showAddForm" text="➕ Nouvel Exercice" style="-fx-background-color: linear-gradient(to right, #6a1b9a, #d500f9); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(106, 27, 154, 0.4), 10, 0, 0, 4);" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <VBox spacing="5">
                        <Label text="Cible" style="-fx-text-fill: #888; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <HBox spacing="5" style="-fx-background-color: white; -fx-padding: 5; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <ToggleButton fx:id="btnSexeTous" text="Tous" toggleGroup="$filterGroupSexe" selected="true" style="-fx-background-radius: 15; -fx-cursor: hand;" />
                            <ToggleButton text="👩 Femme" toggleGroup="$filterGroupSexe" style="-fx-background-radius: 15; -fx-cursor: hand;" />
                            <ToggleButton text="👨 Homme" toggleGroup="$filterGroupSexe" style="-fx-background-radius: 15; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Catégories" style="-fx-text-fill: #888; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <HBox spacing="5" style="-fx-background-color: white; -fx-padding: 5; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                            <ToggleButton fx:id="btnTypeTous" text="Tous" toggleGroup="$filterGroupType" selected="true" style="-fx-background-radius: 15; -fx-cursor: hand;" />
                            <ToggleButton text="Force" toggleGroup="$filterGroupType" style="-fx-background-radius: 15; -fx-cursor: hand;" />
                            <ToggleButton text="Cardio" toggleGroup="$filterGroupType" style="-fx-background-radius: 15; -fx-cursor: hand;" />
                            <ToggleButton text="Souplesse" toggleGroup="$filterGroupType" style="-fx-background-radius: 15; -fx-cursor: hand;" />
                            <ToggleButton text="Endurance" toggleGroup="$filterGroupType" style="-fx-background-radius: 15; -fx-cursor: hand;" />
                            <ToggleButton text="Perte Poids" toggleGroup="$filterGroupType" style="-fx-background-radius: 15; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <VBox alignment="CENTER" spacing="5">
                        <Label text="Tri A-Z" style="-fx-text-fill: #888; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        <Button onAction="#toggleSort" style="-fx-background-color: #9c27b0; -fx-background-radius: 50%; -fx-min-width: 35; -fx-min-height: 35; -fx-cursor: hand;">
                            <graphic><SVGPath fx:id="svgSortIcon" content="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z" fill="#ffffff" scaleX="1.0" scaleY="1.0" /></graphic>
                        </Button>
                    </VBox>
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="cardsFlowPane" hgap="25.0" vgap="25.0" alignment="TOP_CENTER">
                            <padding><Insets top="10.0" bottom="30.0" left="10.0" right="10.0" /></padding>
                        </FlowPane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <StackPane fx:id="overlayPane" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" style="-fx-background-color: rgba(0, 0, 0, 0.6);" />
    </children>
</AnchorPane>