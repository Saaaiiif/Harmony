<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #fdfbfd;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.GestionSportController">

    <fx:define>
        <ToggleGroup fx:id="filterGroupSexe" />
        <ToggleGroup fx:id="filterGroupType" />
    </fx:define>

    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding><Insets top="30.0" right="40.0" bottom="20.0" left="40.0"/></padding>
            <children>

                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="⚡ Bibliothèque Sportive" style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-text-fill: #4a148c; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 3);" />
                    <Label text="Gérez vos exercices, modèles 3D et entraînez-vous comme un pro." style="-fx-font-size: 16px; -fx-text-fill: #8e24aa;" />
                </VBox>

                <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 12 25; -fx-effect: dropshadow(three-pass-box, rgba(74, 20, 140, 0.15), 20, 0, 0, 5); -fx-border-color: #f3e5f5; -fx-border-width: 2; -fx-border-radius: 25;">

                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f3e5f5; -fx-background-radius: 20; -fx-padding: 5 15;">
                        <Label text="🔍" style="-fx-font-size: 18px;" />
                        <TextField fx:id="searchField" promptText="Rechercher un exercice..." style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-pref-width: 200;" />
                    </HBox>

                    <HBox alignment="CENTER" spacing="8" style="-fx-background-color: #faf9fc; -fx-padding: 5; -fx-background-radius: 20; -fx-border-color: #f3e5f5; -fx-border-radius: 20;">
                        <ToggleButton fx:id="btnSexeTous" text="Tous" toggleGroup="$filterGroupSexe" selected="true" />
                        <ToggleButton text="👨 Homme" toggleGroup="$filterGroupSexe" />
                        <ToggleButton text="👩 Femme" toggleGroup="$filterGroupSexe" />
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <Button onAction="#showAddForm" text="➕ Nouvel Exercice" style="-fx-background-color: linear-gradient(to right, #8e24aa, #4a148c); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 10 25; -fx-background-radius: 20; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(142, 36, 170, 0.4), 10, 0, 0, 4);" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="Catégories :" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #4a148c;" />

                    <ScrollPane vbarPolicy="NEVER" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5;">
                            <ToggleButton fx:id="btnTypeTous" text="Toutes" toggleGroup="$filterGroupType" selected="true" />
                            <ToggleButton text="Force" toggleGroup="$filterGroupType" />
                            <ToggleButton text="Cardio" toggleGroup="$filterGroupType" />
                            <ToggleButton text="Souplesse" toggleGroup="$filterGroupType" />
                            <ToggleButton text="Endurance" toggleGroup="$filterGroupType" />
                            <ToggleButton text="Perte Poids" toggleGroup="$filterGroupType" />
                        </HBox>
                    </ScrollPane>

                    <Region HBox.hgrow="ALWAYS" />

                    <HBox alignment="CENTER" spacing="10.0">
                        <Label text="Tri A-Z" style="-fx-text-fill: #8e24aa; -fx-font-weight: bold; -fx-font-size: 14px;" />
                        <Button onAction="#toggleSort" style="-fx-background-color: #8e24aa; -fx-background-radius: 50; -fx-min-width: 40; -fx-min-height: 40; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(142,36,170,0.3), 8, 0, 0, 3);">
                            <graphic><SVGPath fx:id="svgSortIcon" content="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z" fill="#ffffff" scaleX="1.2" scaleY="1.2" /></graphic>
                        </Button>
                    </HBox>
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="cardsFlowPane" hgap="25.0" vgap="25.0" alignment="TOP_CENTER">
                            <padding><Insets top="10.0" bottom="30.0" left="10.0" right="10.0"/></padding>
                        </FlowPane>
                    </content>
                </ScrollPane>

            </children>
        </VBox>

        <StackPane fx:id="overlayPane" visible="false" style="-fx-background-color: rgba(0,0,0,0.6); -fx-backdrop-filter: blur(5px);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
    </children>
</AnchorPane>