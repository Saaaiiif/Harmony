<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f4f4f9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterAlimentFrontController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="800.0" spacing="30.0" style="-fx-background-color: #6a1b9a;">
         <children>
            <Label text="Harmony" textFill="WHITE">
               <font><Font name="System Bold" size="20.0" /></font>
               <HBox.margin><Insets right="40.0" /></HBox.margin>
            </Label>
            <Button mnemonicParsing="false" onAction="#goToAccueil" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Accueil" textFill="WHITE">
               <font><Font name="System Bold" size="14.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#goToAliments" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-underline: true;" text="Aliments" textFill="WHITE">
               <font><Font name="System Bold" size="14.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#goToExercices" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Exercices" textFill="WHITE">
               <font><Font name="System Bold" size="14.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#goToSommeil" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Sommeil" textFill="WHITE">
               <font><Font name="System Bold" size="14.0" /></font>
            </Button>
         </children>
         <padding><Insets left="20.0" right="20.0" /></padding>
      </HBox>

      <VBox alignment="TOP_CENTER" spacing="25.0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="40.0" left="100.0" right="100.0" top="40.0" />
         </padding>
         <children>
            <Label text="Ajouter des aliments au repas" textFill="#333333">
               <font><Font name="System Bold" size="22.0" /></font>
            </Label>

            <HBox spacing="10.0">
               <children>
                  <TextField fx:id="tfRecherche" prefHeight="40.0" promptText="Rechercher un aliment dans la base..." style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" HBox.hgrow="ALWAYS">
                     <font><Font size="14.0" /></font>
                  </TextField>
                  <Button mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: #6a1b9a; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Rechercher">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Button>
               </children>
            </HBox>

            <VBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label text="Combien en avez-vous mangé ?" textFill="#6a1b9a">
                     <font><Font name="System Bold" size="16.0" /></font>
                  </Label>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="tfQuantiteGrammes" prefHeight="35.0" prefWidth="150.0" promptText="Ex: 150" style="-fx-background-radius: 5; -fx-border-color: #cccccc; -fx-border-radius: 5;" />
                        <Label text="Grammes (g)"><font><Font size="14.0" /></font></Label>
                     </children>
                  </HBox>
                  <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #9c27b0; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Ajouter au repas">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Button>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>