<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f4f4f9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.JournalAlimentaireController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="800.0" spacing="30.0" style="-fx-background-color: #6a1b9a;">
            <children>
                <Label text="Harmony" textFill="WHITE">
                    <font><Font name="System Bold" size="20.0" /></font>
                    <HBox.margin><Insets right="40.0" /></HBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#goToAccueil" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Accueil" textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#goToAliments" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-underline: true;" text="Aliments" textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#goToExercices" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Exercices" textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#goToSommeil" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Sommeil" textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
            </children>
            <padding><Insets left="20.0" right="20.0" /></padding>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #f4f4f9;">
                    <padding>
                        <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
                    </padding>
                    <children>
                        <Label text="Votre Journal Alimentaire" textFill="#333333">
                            <font><Font name="System Bold" size="24.0" /></font>
                        </Label>

                        <VBox prefWidth="100.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                            <children>
                                <Label text="Petit déjeuner" textFill="#6a1b9a"><font><Font name="System Bold" size="18.0" /></font></Label>
                                <Button mnemonicParsing="false" onAction="#goToAjouterAliment" style="-fx-background-color: transparent; -fx-text-fill: #9c27b0; -fx-cursor: hand; -fx-padding: 10 0 0 0;" text="+ Ajouter un aliment">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                            </children>
                        </VBox>

                        <VBox prefWidth="100.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                            <children>
                                <Label text="Déjeuner" textFill="#6a1b9a"><font><Font name="System Bold" size="18.0" /></font></Label>
                                <Button mnemonicParsing="false" onAction="#goToAjouterAliment" style="-fx-background-color: transparent; -fx-text-fill: #9c27b0; -fx-cursor: hand; -fx-padding: 10 0 0 0;" text="+ Ajouter un aliment">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                            </children>
                        </VBox>

                        <VBox prefWidth="100.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                            <children>
                                <Label text="Dîner" textFill="#6a1b9a"><font><Font name="System Bold" size="18.0" /></font></Label>
                                <Button mnemonicParsing="false" onAction="#goToAjouterAliment" style="-fx-background-color: transparent; -fx-text-fill: #9c27b0; -fx-cursor: hand; -fx-padding: 10 0 0 0;" text="+ Ajouter un aliment">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                            </children>
                        </VBox>

                        <VBox prefWidth="100.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                            <children>
                                <Label text="Snacks" textFill="#6a1b9a"><font><Font name="System Bold" size="18.0" /></font></Label>
                                <Button mnemonicParsing="false" onAction="#goToAjouterAliment" style="-fx-background-color: transparent; -fx-text-fill: #9c27b0; -fx-cursor: hand; -fx-padding: 10 0 0 0;" text="+ Ajouter un aliment">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Button>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>