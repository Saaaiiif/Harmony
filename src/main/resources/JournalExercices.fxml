<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #f4f4f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.JournalExercicesController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="1080.0" style="-fx-background-color: #6a1b9a;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Button mnemonicParsing="false" onAction="#goToAccueil" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;" text="Accueil">
                    <HBox.margin> <Insets left="40.0" right="20.0" /> </HBox.margin>
                </Button>
                <Button mnemonicParsing="false" onAction="#goToAliments" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;" text="Aliments">
                    <HBox.margin> <Insets right="20.0" /> </HBox.margin>
                </Button>
                <Button mnemonicParsing="false" onAction="#goToExercices" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-underline: true; -fx-cursor: hand;" text="Exercices">
                    <HBox.margin> <Insets right="20.0" /> </HBox.margin>
                </Button>
                <Button mnemonicParsing="false" onAction="#goToSommeil" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;" text="Sommeil" />
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
            <content>
                <VBox prefWidth="1000.0" spacing="30.0">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>
                        <Label text="Votre journal d'exercices" textFill="#6a1b9a">
                            <font> <Font name="System Bold" size="24.0" /> </font>
                        </Label>

                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8;">
                            <children>
                                <Label text="Cardiovasculaire" textFill="#6a1b9a">
                                    <font> <Font name="System Bold" size="18.0" /> </font>
                                </Label>
                                <Button mnemonicParsing="false" onAction="#ajouterCardio" style="-fx-background-color: transparent; -fx-text-fill: #9c27b0; -fx-cursor: hand;" text="+ Ajouter un exercice" />
                            </children>
                        </VBox>

                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8;">
                            <children>
                                <Label text="Musculation" textFill="#6a1b9a">
                                    <font> <Font name="System Bold" size="18.0" /> </font>
                                </Label>
                                <Button mnemonicParsing="false" onAction="#ajouterMusculation" style="-fx-background-color: transparent; -fx-text-fill: #9c27b0; -fx-cursor: hand;" text="+ Ajouter un exercice" />
                            </children>
                        </VBox>

                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Notes de la séance (Obligatoire) *" textFill="#6a1b9a">
                                            <font> <Font name="System Bold" size="18.0" /> </font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#enregistrerSeance" style="-fx-background-color: #6a1b9a; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;" text="Enregistrer la séance" />
                                    </children>
                                </HBox>
                                <Label fx:id="erreurLabel" text="" textFill="RED" />
                                <TextArea fx:id="notesTextArea" prefHeight="100.0" prefWidth="200.0" promptText="Comment vous êtes-vous senti aujourd'hui ? (Obligatoire)" style="-fx-background-color: #f9f9f9; -fx-border-color: #cccccc;" />
                            </children>
                        </VBox>

                        <VBox spacing="10.0">
                            <children>
                                <Label text="Historique de vos séances" textFill="#6a1b9a">
                                    <font> <Font name="System Bold" size="22.0" /> </font>
                                </Label>
                                <TableView fx:id="seancesTable" prefHeight="200.0" prefWidth="200.0">
                                    <columns>
                                        <TableColumn prefWidth="150.0" text="Date" />
                                        <TableColumn prefWidth="400.0" text="Notes" />
                                        <TableColumn prefWidth="150.0" text="Actions" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>