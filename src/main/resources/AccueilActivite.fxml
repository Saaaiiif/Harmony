<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f4f4f9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AccueilActiviteController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="800.0" spacing="30.0" style="-fx-background-color: #6a1b9a;">
            <children>
                <Label text="Harmony" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="40.0" />
                    </HBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#goToAccueil" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-underline: true;" text="Accueil" textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#goToAliments" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Aliments" textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#goToExercices" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Exercices" textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#goToSommeil" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Sommeil" textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
            </children>
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
        </HBox>

        <AnchorPane prefHeight="540.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
            <children>
                <Label layoutX="216.0" layoutY="243.0" text="Bienvenue dans votre espace Activité" textFill="#6a1b9a">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>
    </children>
</VBox>