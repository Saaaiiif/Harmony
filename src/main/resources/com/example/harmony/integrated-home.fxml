<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.harmony.IntegratedHomeController"
            style="-fx-background-color: linear-gradient(135deg, #0EA5E9 0%, #8B5CF6 100%);">

    <VBox alignment="CENTER" spacing="18"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0">

        <VBox alignment="CENTER" spacing="6">
            <Label text="Harmony — Application intégrée"
                   style="-fx-text-fill: white; -fx-font-size: 34px; -fx-font-weight: bold;"/>
            <Label text="Choisis le module à ouvrir"
                   style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 16px;"/>
        </VBox>

        <HBox spacing="14" alignment="CENTER">
            <Button fx:id="forumButton"
                    text="Forum &amp; Utilisateurs"
                    onAction="#openForum"
                    style="-fx-background-color: rgba(255,255,255,0.92); -fx-text-fill: #111827; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 14;"
                    prefWidth="260" prefHeight="58"/>

            <Button fx:id="planningButton"
                    text="Planning &amp; Tâches"
                    onAction="#openPlanning"
                    style="-fx-background-color: rgba(255,255,255,0.92); -fx-text-fill: #111827; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 14;"
                    prefWidth="260" prefHeight="58"/>
        </HBox>

        <VBox alignment="CENTER" spacing="8"
              style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 14;">
            <padding>
                <Insets top="14" right="18" bottom="14" left="18"/>
            </padding>
            <Label text="Administration"
                   style="-fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Button fx:id="adminPlanningButton"
                    text="Backoffice Planning (Admin)"
                    onAction="#openAdminPlanning"
                    style="-fx-background-color: rgba(17,24,39,0.85); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 12;"
                    prefWidth="360" prefHeight="46"/>
        </VBox>
    </VBox>

</AnchorPane>

