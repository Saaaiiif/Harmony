<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.harmony.AdminBackofficeController"
      styleClass="admin-backoffice"
      spacing="16"
      prefWidth="1200" prefHeight="700">

    <Label text="Backoffice Administrateur" styleClass="admin-title" VBox.vgrow="NEVER"/>

    <TabPane fx:id="adminTabPane" styleClass="admin-tab-pane" VBox.vgrow="ALWAYS">
        <!-- Onglet Gestion des Salles -->
        <Tab text="Gestion des Salles" closable="false">
            <VBox spacing="12">
                <HBox alignment="CENTER_LEFT" styleClass="admin-header">
                    <Label text="Salles" styleClass="admin-section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="admin-actions">
                        <Button text="Ajouter" styleClass="btn-admin btn-add" onAction="#onAjouterSalle"/>
                        <Button text="Modifier" styleClass="btn-admin btn-edit" onAction="#onModifierSalle"/>
                        <Button text="Supprimer" styleClass="btn-admin btn-delete" onAction="#onSupprimerSalle"/>
                    </HBox>
                </HBox>
                <TableView fx:id="salleTable" VBox.vgrow="ALWAYS" styleClass="admin-table">
                    <columns>
                        <TableColumn fx:id="colSalleId" text="Id" prefWidth="50"/>
                        <TableColumn fx:id="colSalleNom" text="Nom" prefWidth="150"/>
                        <TableColumn fx:id="colSalleCapacite" text="Capacité" prefWidth="80"/>
                        <TableColumn fx:id="colSalleEquipements" text="Équipements" prefWidth="200"/>
                        <TableColumn fx:id="colSalleDisponible" text="Disponible" prefWidth="100"/>
                        <TableColumn fx:id="colSalleDescription" text="Description" prefWidth="250"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- Onglet Confirmation des Séances -->
        <Tab text="Confirmation des Séances" closable="false">
            <VBox spacing="12">
                <HBox alignment="CENTER_LEFT" styleClass="admin-header">
                    <Label text="Séances en attente de confirmation" styleClass="admin-section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="admin-actions">
                        <Button text="Confirmer" styleClass="btn-admin btn-confirm" onAction="#onConfirmerSeance"/>
                        <Button text="Rejeter" styleClass="btn-admin btn-reject" onAction="#onRejeterSeance"/>
                    </HBox>
                </HBox>
                <TableView fx:id="seanceTable" VBox.vgrow="ALWAYS" styleClass="admin-table">
                    <columns>
                        <TableColumn fx:id="colSeanceId" text="Id" prefWidth="50"/>
                        <TableColumn fx:id="colSeanceTitre" text="Titre" prefWidth="180"/>
                        <TableColumn fx:id="colSeanceDateDebut" text="Date début" prefWidth="120"/>
                        <TableColumn fx:id="colSeanceDateFin" text="Date fin" prefWidth="120"/>
                        <TableColumn fx:id="colSeanceSalle" text="Salle" prefWidth="100"/>
                        <TableColumn fx:id="colSeanceConfirmee" text="Confirmée" prefWidth="100"/>
                        <TableColumn fx:id="colSeanceType" text="Type" prefWidth="100"/>
                        <TableColumn fx:id="colSeanceParticipants" text="Participants" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
</VBox>
