<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.harmony.NavWheelController"
           pickOnBounds="false"
           styleClass="nav-wheel-bottom-wrap">

    <StackPane fx:id="wheelZone"
               prefWidth="200"
               maxWidth="200"
               prefHeight="120"
               styleClass="nav-wheel-host">
        <StackPane fx:id="navWheelContainer" prefHeight="160"/>
    </StackPane>
</StackPane>
