<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.etudiant.EtudiantMeditationDetailController"
      spacing="20" styleClass="detail-container" stylesheets="@../css/style.css">

    <HBox>
        <Button text="← Retour aux sessions" styleClass="btn-secondary" onAction="#goBack"/>
    </HBox>

    <VBox styleClass="detail-header" spacing="15">
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label fx:id="themeLabel" text="" styleClass="title-label"/>
            <Label fx:id="durationLabel" text="" styleClass="duration-tag"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Par" styleClass="subtitle-label"/>
            <Label fx:id="auteurLabel" text="" styleClass="label" style="-fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <VBox fx:id="audioSection" styleClass="card" spacing="15">
        <Label text="🎵 Écouter la session" styleClass="section-title"/>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Button fx:id="playButton" text="▶ Écouter" styleClass="btn-primary" onAction="#playAudio"/>
            <Label fx:id="audioUrlLabel" text="" styleClass="subtitle-label" wrapText="true" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

    <VBox spacing="15" VBox.vgrow="ALWAYS">
        <Label text="💡 Conseils pour cette session" styleClass="section-title"/>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
            <VBox fx:id="conseilsContainer" spacing="12">
                <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
            </VBox>
        </ScrollPane>

        <VBox fx:id="noConseilsState" alignment="CENTER" spacing="10" visible="false" managed="false">
            <Label text="💭" style="-fx-font-size: 40px;"/>
            <Label text="Aucun conseil disponible pour cette session" styleClass="subtitle-label"/>
        </VBox>
    </VBox>

</VBox>
