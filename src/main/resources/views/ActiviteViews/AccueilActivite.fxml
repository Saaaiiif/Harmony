<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" styleClass="main-root-light"
            stylesheets="@/views/admin-styles.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ActiviteControllers.AccueilActiviteController">



    <!-- ===== CONTENU PRINCIPAL SCROLLABLE ===== -->
    <ScrollPane fitToWidth="true"
                style="-fx-background: transparent; -fx-background-color: transparent;"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
        <content>
            <VBox spacing="22.0" alignment="TOP_CENTER"
                  style="-fx-background-color: #f8f5fc; -fx-padding: 25 45 45 45;">

                <!-- ── NAVIGATION DATE ── -->
                <HBox alignment="CENTER" spacing="18.0"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-padding: 13 28;
                             -fx-effect: dropshadow(three-pass-box, rgba(106,27,154,0.13), 10, 0, 0, 4);">
                    <Button fx:id="btnPrevDay" onAction="#jourPrecedent" text="◀"
                            style="-fx-background-color: #6a1b9a; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 50;
                                   -fx-min-width: 36; -fx-min-height: 36; -fx-cursor: hand;"/>
                    <Label fx:id="lblDateJour" text="Aujourd'hui"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #4a148c;
                                  -fx-min-width: 280; -fx-alignment: CENTER;"/>
                    <Button fx:id="btnNextDay" onAction="#jourSuivant" text="▶"
                            style="-fx-background-color: #6a1b9a; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 50;
                                   -fx-min-width: 36; -fx-min-height: 36; -fx-cursor: hand;"/>
                    <Button onAction="#allerAujourdhui" text="Aujourd'hui"
                            style="-fx-background-color: transparent; -fx-text-fill: #9c27b0;
                                   -fx-font-size: 13px; -fx-cursor: hand; -fx-underline: true;"/>
                </HBox>

                <!-- ── RANG 1 : CARTE CALORIES + CARTE TÉLÉPHONE ── -->
                <HBox spacing="20.0" alignment="CENTER">

                    <!-- CARTE CALORIES -->
                    <VBox spacing="16.0"
                          style="-fx-background-color: white; -fx-background-radius: 20;
                                 -fx-padding: 25 28;
                                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.09), 12, 0, 0, 5);"
                          prefWidth="490.0">
                        <Label text="Calories"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Reste = Objectif − Aliments + Exercices"
                               style="-fx-font-size: 12px; -fx-text-fill: #9e9e9e;"/>
                        <HBox alignment="CENTER" spacing="30.0">
                            <!-- Indicateur circulaire dessiné par le controller -->
                            <StackPane fx:id="circularCaloriesPane"
                                       prefWidth="148.0" prefHeight="148.0"
                                       alignment="CENTER"/>
                            <!-- Statistiques -->
                            <VBox spacing="16.0" alignment="CENTER_LEFT">
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <Label text="🏁" style="-fx-font-size: 20px;"/>
                                    <VBox spacing="1.0">
                                        <Label text="Objectif de base"
                                               style="-fx-font-size: 11px; -fx-text-fill: #9e9e9e;"/>
                                        <Label fx:id="lblObjectifBase" text="2150"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <Label text="🍴" style="-fx-font-size: 20px;"/>
                                    <VBox spacing="1.0">
                                        <Label text="Aliments"
                                               style="-fx-font-size: 11px; -fx-text-fill: #9e9e9e;"/>
                                        <Label fx:id="lblAlimentsKcal" text="0"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <Label text="🔥" style="-fx-font-size: 20px;"/>
                                    <VBox spacing="1.0">
                                        <Label text="Exercices"
                                               style="-fx-font-size: 11px; -fx-text-fill: #9e9e9e;"/>
                                        <Label fx:id="lblExercicesKcal" text="0"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e65100;"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>
                        <!-- Alerte calories (cachée par défaut) -->
                        <Label fx:id="lblAlerteCalories" text="" wrapText="true" maxWidth="430.0"
                               style="-fx-font-size: 13px; -fx-text-fill: #c62828;
                                      -fx-font-weight: bold; -fx-wrap-text: true;"/>
                    </VBox>

                    <!-- CARTE CENTRE D'ALERTES HARMONY -->
                    <VBox spacing="12.0"
                          style="-fx-background-color: white; -fx-background-radius: 20;
                                 -fx-padding: 25 28;
                                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.09), 12, 0, 0, 5);"
                          prefWidth="310.0">
                        <Label text="🔔 Centre d'Alertes"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Harmony surveille vos objectifs et vous informe en temps réel."
                               wrapText="true"
                               style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                        <Separator style="-fx-opacity: 0.2;"/>
                        <!-- Zone dynamique des alertes (remplie par le Controller) -->
                        <VBox fx:id="vboxAlertes" spacing="8.0"/>
                        <Button onAction="#verifierAlertes" text="🔄  Actualiser les alertes"
                                style="-fx-background-color: linear-gradient(to right, #6a1b9a, #d500f9);
                                       -fx-text-fill: white; -fx-font-weight: bold;
                                       -fx-background-radius: 20; -fx-padding: 10 20; -fx-cursor: hand;
                                       -fx-effect: dropshadow(three-pass-box, rgba(106,27,154,0.3), 8, 0, 0, 3);"/>
                        <Label fx:id="lblDerniereVerif" text=""
                               style="-fx-font-size: 11px; -fx-text-fill: #9e9e9e; -fx-font-style: italic;"/>
                    </VBox>
                </HBox>

                <!-- ── CITATION DU JOUR (DESIGN CONSERVÉ) ── -->
                <VBox alignment="CENTER" spacing="18.0" maxWidth="700.0"
                      style="-fx-background-color: white; -fx-background-radius: 20px;
                             -fx-border-color: #6a1b9a; -fx-border-width: 0 0 0 6;
                             -fx-border-radius: 20px; -fx-padding: 35 40 30 40;
                             -fx-effect: dropshadow(three-pass-box, rgba(106,27,154,0.18), 20, 0, 0, 8);">
                    <HBox alignment="CENTER" spacing="10.0">
                        <Label text="💬" style="-fx-font-size: 26px;"/>
                        <Label text="Citation du jour"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #9c27b0;"/>
                    </HBox>
                    <Region prefHeight="1.0" prefWidth="200.0"
                            style="-fx-background-color: linear-gradient(to right, transparent, #d500f9, transparent);"/>
                    <Label fx:id="lblQuoteText"
                           text="Chargement de votre inspiration du jour..."
                           textFill="#333333" wrapText="true" maxWidth="620.0"
                           style="-fx-font-size: 17px; -fx-font-style: italic; -fx-text-alignment: center;"/>
                    <Label fx:id="lblQuoteAuthor" text="..."
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #9c27b0;"/>
                    <Button onAction="#changerCitation" text="🔄  Nouvelle citation"
                            style="-fx-background-color: linear-gradient(to right, #6a1b9a, #d500f9);
                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;
                                   -fx-background-radius: 30; -fx-padding: 9 25; -fx-cursor: hand;
                                   -fx-effect: dropshadow(three-pass-box, rgba(106,27,154,0.3), 8, 0, 0, 3);"/>
                </VBox>

                <!-- ── CARTE OBJECTIFS FITNESS ── -->
                <VBox maxWidth="800.0" spacing="0.0"
                      style="-fx-background-color: white; -fx-background-radius: 20;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.09), 12, 0, 0, 5);">

                    <!-- En-tête -->
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 22 25 15 25;">
                        <VBox spacing="3.0">
                            <Label text="Vos objectifs fitness"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            <Label text="Voulez-vous de l'aide pour définir vos objectifs ?"
                                   style="-fx-font-size: 12px; -fx-text-fill: #9e9e9e;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#ouvrirModificationObjectifs" text="MODIFIER"
                                style="-fx-background-color: transparent; -fx-text-fill: #1976d2;
                                       -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"/>
                    </HBox>
                    <Separator style="-fx-opacity: 0.25;"/>

                    <!-- Sous-titre: Objectifs nutritionnels -->
                    <HBox style="-fx-padding: 14 25 8 25;">
                        <Label text="Objectifs nutritionnels quotidiens"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>
                    </HBox>

                    <!-- Ligne Calories -->
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 11 25; -fx-background-color: #fafafa;">
                        <Label text="Calories"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #212121; -fx-min-width: 240;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblObjCal" text="2150"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6a1b9a;"/>
                    </HBox>
                    <Separator style="-fx-opacity: 0.12;"/>

                    <!-- Ligne Glucides -->
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 11 25; -fx-background-color: white;">
                        <VBox spacing="2.0">
                            <Label text="Glucides"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #212121;"/>
                            <Label fx:id="lblObjGluG" text="161 g"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9e9e9e;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblObjGluPct" text="30 %"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>
                    </HBox>
                    <Separator style="-fx-opacity: 0.12;"/>

                    <!-- Ligne Lipides -->
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 11 25; -fx-background-color: #fafafa;">
                        <VBox spacing="2.0">
                            <Label text="Lipides"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #212121;"/>
                            <Label fx:id="lblObjLipG" text="24 g"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9e9e9e;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblObjLipPct" text="10 %"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e65100;"/>
                    </HBox>
                    <Separator style="-fx-opacity: 0.12;"/>

                    <!-- Ligne Protéines -->
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 11 25; -fx-background-color: white;">
                        <VBox spacing="2.0">
                            <Label text="Protéines"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #212121;"/>
                            <Label fx:id="lblObjProtG" text="323 g"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9e9e9e;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblObjProtPct" text="60 %"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #c62828;"/>
                    </HBox>
                    <Separator style="-fx-opacity: 0.25;"/>

                    <!-- Sous-titre: Fitness -->
                    <HBox style="-fx-padding: 14 25 8 25;">
                        <Label text="Fitness"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>
                    </HBox>

                    <!-- Calories brûlées/semaine -->
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 11 25; -fx-background-color: #fafafa;">
                        <Label text="Calories brûlées/semaine"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #212121; -fx-min-width: 280;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblObjCalBrulees" text="0 Calories"
                               style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
                    </HBox>
                    <Separator style="-fx-opacity: 0.12;"/>

                    <!-- Entraînements/Semaine -->
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 11 25; -fx-background-color: white;">
                        <Label text="Entraînements/Semaine"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #212121; -fx-min-width: 280;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblObjEntrainements" text="0 entraînements"
                               style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
                    </HBox>
                    <Separator style="-fx-opacity: 0.12;"/>

                    <!-- Minutes/entraînement -->
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 11 25; -fx-background-color: #fafafa;">
                        <Label text="Minutes/entraînement"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #212121; -fx-min-width: 280;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblObjMinutes" text="0"
                               style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
                    </HBox>
                    <Separator style="-fx-opacity: 0.12;"/>

                    <!-- Eau quotidienne -->
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 11 25 20 25; -fx-background-color: white;">
                        <Label text="Eau/jour"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #212121; -fx-min-width: 280;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblObjEau" text="2000 ml"
                               style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
                    </HBox>
                </VBox>

                <!-- Bouton télécharger PDF -->
                <HBox alignment="CENTER">
                    <Button onAction="#genererBilanPDF" text="📥 Télécharger le bilan PDF"
                            style="-fx-background-color: linear-gradient(to right, #6a1b9a, #d500f9);
                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;
                                   -fx-background-radius: 25; -fx-padding: 12 30; -fx-cursor: hand;
                                   -fx-effect: dropshadow(three-pass-box, rgba(106,27,154,0.3), 8, 0, 0, 3);"/>
                </HBox>

            </VBox>
        </content>
    </ScrollPane>

    <!-- ===== OVERLAY OBJECTIFS ===== -->
    <StackPane fx:id="overlayObjectifs" visible="false"
               style="-fx-background-color: rgba(0,0,0,0.5);"
               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
               alignment="CENTER"/>

</AnchorPane>