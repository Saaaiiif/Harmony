<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0"
            styleClass="main-root-light"
            stylesheets="@/views/admin-styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ActiviteControllers.GestionNutritionController">

    <fx:define>
        <ToggleGroup fx:id="filterGroupNutri" />
    </fx:define>

    <children>
        <VBox alignment="TOP_CENTER" spacing="30.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets top="30.0" right="40.0" bottom="20.0" left="40.0"/>
            </padding>
            <children>

                <!-- Titre -->
                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="🍏 Bibliothèque Nutritionnelle"
                           style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4a148c;" />
                    <Label text="Gérez vos aliments, filtrez par macros et modifiez vos données."
                           style="-fx-text-fill: #8e24aa; -fx-font-size: 16px; -fx-font-weight: bold;" />
                </VBox>

                <!-- Formulaire d'ajout -->
                <VBox alignment="CENTER" spacing="15.0" styleClass="glass-card">
                    <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>

                    <HBox alignment="CENTER" spacing="10.0">
                        <TextField fx:id="nomField" prefWidth="150.0" promptText="🍎 Nom"
                                   styleClass="neon-input-small" />
                        <TextField fx:id="caloriesField" prefWidth="100.0" promptText="🔥 Cal"
                                   styleClass="neon-input-small" />
                        <TextField fx:id="proteinesField" prefWidth="100.0" promptText="🥩 Prot(g)"
                                   styleClass="neon-input-small" />
                        <TextField fx:id="glucidesField" prefWidth="100.0" promptText="🍞 Glu(g)"
                                   styleClass="neon-input-small" />
                        <TextField fx:id="lipidesField" prefWidth="100.0" promptText="🥑 Lip(g)"
                                   styleClass="neon-input-small" />
                        <Button text="➕ Ajouter" onAction="#ajouterAliment" styleClass="btn-neon-action" />
                    </HBox>
                    <Label fx:id="messageLabel" text=""
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #ff1744;" />

                    <Separator style="-fx-opacity: 0.3; -fx-background-color: #aa00ff;" />

                    <!-- Barre de recherche + filtres -->
                    <HBox alignment="CENTER" spacing="15.0">
                        <TextField fx:id="searchField" prefWidth="280.0"
                                   promptText="🔍 Rechercher un aliment..."
                                   styleClass="neon-input-small" />

                        <HBox alignment="CENTER" spacing="10.0">
                            <ToggleButton fx:id="btnFilterAll" selected="true"
                                          styleClass="filter-toggle-btn" text="Tous"
                                          toggleGroup="$filterGroupNutri" />
                            <ToggleButton fx:id="btnFilterPro"
                                          styleClass="filter-toggle-btn" text="🥩 + Protéines"
                                          toggleGroup="$filterGroupNutri" />
                            <ToggleButton fx:id="btnFilterGlu"
                                          styleClass="filter-toggle-btn" text="🍞 + Glucides"
                                          toggleGroup="$filterGroupNutri" />
                            <ToggleButton fx:id="btnFilterLip"
                                          styleClass="filter-toggle-btn" text="🥑 + Lipides"
                                          toggleGroup="$filterGroupNutri" />
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER" spacing="10.0">
                            <Label text="Tri A-Z"
                                   style="-fx-text-fill: #8e24aa; -fx-font-weight: bold;" />
                            <Button onAction="#toggleSort" styleClass="btn-neon-action">
                                <graphic>
                                    <SVGPath fx:id="svgSortIcon"
                                             content="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z"
                                             fill="#ffffff" scaleX="1.2" scaleY="1.2" />
                                </graphic>
                                <tooltip><Tooltip text="Inverser le tri" /></tooltip>
                            </Button>
                        </HBox>
                    </HBox>
                </VBox>

                <!-- Grille d'aliments -->
                <ScrollPane fitToWidth="true" styleClass="transparent-scroll-pane" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="cardsContainer" hgap="25.0" vgap="25.0" alignment="TOP_CENTER">
                            <padding><Insets top="10.0" bottom="30.0" left="10.0" right="10.0" /></padding>
                        </FlowPane>
                    </content>
                </ScrollPane>

            </children>
        </VBox>

        <!-- Overlay pour les modales -->
        <StackPane fx:id="overlayPane" visible="false"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
                   style="-fx-background-color: rgba(0,0,0,0.6);" />
    </children>
</AnchorPane>
