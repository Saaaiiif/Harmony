<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<!--
    Sidebar partagée entre DashboardAdmin.fxml et GestionUsers.fxml (et toutes les pages admin futures).
    Intégration : <fx:include fx:id="sidebar" source="AdminSidebar.fxml"/>
    Le controller parent récupère AdminSidebarController via @FXML AdminSidebarController sidebarController
    et appelle sidebarController.setActiveButton("dashboard") ou ("gestionUsers").
-->
<VBox fx:id="sidebarRoot" prefHeight="700" prefWidth="240"
      style="-fx-background-color: linear-gradient(to bottom, #1F2937, #111827);
             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 15, 0, 5, 0);"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AdminSidebarController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="25" />
    </padding>

    <!-- ── Logo ── -->
    <VBox alignment="CENTER" spacing="4">
        <Label style="-fx-font-size: 44;" text="⚡" textFill="#cb96d3" />
        <Label style="-fx-font-size: 26; -fx-text-fill: white; -fx-font-weight: bold;" text="Harmony" />
        <Label style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="Admin Dashboard" />
    </VBox>

    <!-- Séparateur -->
    <Region prefHeight="18" />
    <Separator style="-fx-background-color: #374151;" opacity="0.5" />
    <Region prefHeight="14" />

    <!-- ── Navigation ── -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">

        <Button fx:id="btnDashboard" onAction="#handleDashboard"
                prefHeight="45" prefWidth="200"
                style="-fx-background-color: #374151; -fx-text-fill: white; -fx-font-size: 13;
                       -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;
                       -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 18;"
                text="🏠 Dashboard" />

        <Button fx:id="btnGestionUsers" onAction="#handleGestionUsers"
                prefHeight="45" prefWidth="200"
                style="-fx-background-color: #374151; -fx-text-fill: white; -fx-font-size: 13;
                       -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;
                       -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 18;"
                text="👥 Gestion Utilisateurs" />

        <!-- Region pousse le reste en bas -->
        <Region VBox.vgrow="ALWAYS" />

        <!-- ── Déconnexion ── -->
        <Button fx:id="btnLogout" onAction="#handleLogout"
                prefHeight="42" prefWidth="200"
                style="-fx-background-color: transparent; -fx-text-fill: #9CA3AF; -fx-font-size: 12;
                       -fx-background-radius: 10; -fx-cursor: hand;
                       -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 18;
                       -fx-border-color: #374151; -fx-border-width: 1; -fx-border-radius: 10;"
                text="🚪 Déconnexion" />
    </VBox>

    <!-- Séparateur avant le profil -->
    <Region prefHeight="14" />
    <Separator style="-fx-background-color: #374151;" opacity="0.5" />
    <Region prefHeight="14" />

    <!-- ── Zone Profil Admin (en bas) ── -->
    <StackPane fx:id="profileZone" alignment="CENTER"
               onMouseEntered="#handleProfileHover"
               onMouseExited="#handleProfileHoverEnd"
               onMouseClicked="#handleProfileClick"
               style="-fx-cursor: hand;">

        <!-- Tooltip personnalisé (visible au survol) -->
        <VBox fx:id="profileTooltip" alignment="CENTER_LEFT" spacing="4"
              visible="false" managed="false"
              style="-fx-background-color: #374151; -fx-background-radius: 12;
                     -fx-padding: 12 16; -fx-translate-y: -85;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 12, 0, 0, 4);">
            <Label fx:id="tooltipNom"
                   style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;"
                   text="Admin" />
            <Label fx:id="tooltipEmail"
                   style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;"
                   text="admin@harmony.com" />
            <Label style="-fx-font-size: 10; -fx-text-fill: #6B7280; -fx-padding: 4 0 0 0;"
                   text="Double-clic pour modifier le profil" />
        </VBox>

        <!-- Bouton avatar circulaire -->
        <VBox alignment="CENTER" spacing="6">

            <!-- Conteneur circulaire de l'avatar -->
            <StackPane fx:id="avatarContainer"
                       prefWidth="54" prefHeight="54"
                       style="-fx-background-color: linear-gradient(to bottom right, #A78BFA, #8B5CF6);
                              -fx-background-radius: 27;
                              -fx-effect: dropshadow(three-pass-box, rgba(139,92,246,0.5), 10, 0, 0, 3);">

                <!-- Initiale (affichée si pas d'image) -->
                <Label fx:id="avatarInitial"
                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"
                       text="A" />

                <!-- Image de profil (cachée par défaut) -->
                <ImageView fx:id="avatarImage"
                           fitWidth="54" fitHeight="54"
                           preserveRatio="false"
                           visible="false">
                    <clip>
                        <Circle centerX="27" centerY="27" radius="27" />
                    </clip>
                </ImageView>
            </StackPane>

            <Label fx:id="profileNameLabel"
                   style="-fx-font-size: 11; -fx-text-fill: #D1D5DB; -fx-font-weight: bold;"
                   text="Mon Profil" />
        </VBox>
    </StackPane>

</VBox>
