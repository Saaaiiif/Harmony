<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!-- Fenêtre popup indépendante (Stage modal) — aucun AnchorPane wrapper -->
<VBox alignment="TOP_CENTER" spacing="20" prefWidth="520"
      style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.FaceVerificationController">
    <padding>
        <Insets bottom="30" left="35" right="35" top="30" />
    </padding>

    <!-- ── En-tête ── -->
    <VBox alignment="CENTER" spacing="8"
          style="   -fx-background-radius: 14; -fx-padding: 22;">
        <Label style="-fx-font-size: 36;" text="🔐" />
        <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"
               text="Vérification biométrique" />
        <Label wrapText="true" maxWidth="420"
               style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.85); -fx-text-alignment: center;"
               text="Placez votre visage face à la caméra pour confirmer votre identité." />
    </VBox>

    <!-- ── Vue caméra ── -->
    <StackPane prefWidth="450" prefHeight="310"
               style="-fx-background-color: #111827; -fx-background-radius: 14;
                      -fx-border-color: #8B5CF6; -fx-border-width: 2.5; -fx-border-radius: 14;
                      -fx-effect: dropshadow(three-pass-box, rgba(139,92,246,0.3), 16, 0, 0, 4);">

        <ImageView fx:id="cameraView"
                   fitWidth="450" fitHeight="310"
                   preserveRatio="true" />

        <!-- Placeholder -->
        <VBox fx:id="cameraPlaceholder" alignment="CENTER" spacing="10"
              style="-fx-background-color: #111827; -fx-background-radius: 12;">
            <Label style="-fx-font-size: 46;" text="📷" />
            <Label style="-fx-font-size: 13; -fx-text-fill: #6B7280;"
                   text="Démarrage de la caméra..." />
        </VBox>

        <!-- Overlay résultat -->
        <Label fx:id="overlayResult"
               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;
                      -fx-padding: 8 18; -fx-background-radius: 20; -fx-translate-y: 120;"
               visible="false" />
    </StackPane>

    <!-- ── Indicateur de statut ── -->
    <VBox alignment="CENTER" spacing="6">
        <!-- Barre de progression -->
        <ProgressBar fx:id="progressBar" prefWidth="450" prefHeight="8"
                     progress="0"
                     style="-fx-accent: #8B5CF6; -fx-background-radius: 4;" />

        <Label fx:id="statusLabel"
               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #8B5CF6;"
               text="🔍  Recherche de votre visage..." />

        <Label fx:id="attemptsLabel"
               style="-fx-font-size: 12; -fx-text-fill: #9CA3AF;"
               text="" />
    </VBox>

    <!-- ── Boutons ── -->
    <HBox alignment="CENTER" spacing="14">
        <Button fx:id="btnVerifier" onAction="#handleVerifierMaintenant"
                prefHeight="45" prefWidth="200"
                style="-fx-background-color: linear-gradient(to right, #8B5CF6, #7C3AED);
                       -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;
                       -fx-background-radius: 10; -fx-cursor: hand;"
                text="📸  Vérifier maintenant" />

        <Button onAction="#handleAnnuler"
                prefHeight="45" prefWidth="160"
                style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                       -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10;
                       -fx-cursor: hand; -fx-border-color: #D1D5DB; -fx-border-width: 1.5;
                       -fx-border-radius: 10;"
                text="✕  Annuler" />
    </HBox>

    <!-- Note -->
    <Label wrapText="true" maxWidth="450"
           style="-fx-font-size: 11; -fx-text-fill: #9CA3AF; -fx-text-alignment: center;"
           text="💡 Conseil : assurez-vous d'être dans un endroit bien éclairé pour une meilleure reconnaissance." />

</VBox>
