<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800" prefWidth="931.0"
            style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.UserControlleers.LoginController">

    <VBox alignment="CENTER" layoutX="241.0" layoutY="18.0" prefWidth="450" spacing="20"
          style="-fx-background-color: white; -fx-background-radius: 20;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 25, 0, 0, 10);">
        <padding>
            <Insets bottom="40" left="50" right="50" top="40" />
        </padding>

        <!-- En-tête -->
        <VBox alignment="CENTER" spacing="8">
            <Label style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #1F2937;"
                   text="Bienvenue sur Harmony" />
            <Label style="-fx-font-size: 15; -fx-text-fill: #6B7280;"
                   text="Connectez-vous pour accéder à votre compte" />
        </VBox>

        <!-- Email -->
        <VBox spacing="6">
            <Label style="-fx-font-size: 14; -fx-text-fill: #374151; -fx-font-weight: bold;" text="Email" />
            <TextField fx:id="emailLogin" prefHeight="50"
                       style="-fx-background-color: #F3F4F6; -fx-background-radius: 12;
                              -fx-text-fill: #1F2937; -fx-font-size: 14; -fx-padding: 0 20;" />
        </VBox>

        <!-- Mot de passe -->
        <VBox spacing="6">
            <HBox alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 14; -fx-text-fill: #374151; -fx-font-weight: bold;"
                       text="Mot de passe" HBox.hgrow="ALWAYS" />
                <Region HBox.hgrow="ALWAYS" />
                <Hyperlink fx:id="linkForgotPassword"
                           style="-fx-font-size: 13; -fx-text-fill: #8B5CF6; -fx-font-weight: bold;
                                  -fx-border-color: transparent;"
                           text="Mot de passe oublié ?" />
            </HBox>
            <PasswordField fx:id="passwordLogin" prefHeight="50"
                           style="-fx-background-color: #F3F4F6; -fx-background-radius: 12;
                                  -fx-text-fill: #1F2937; -fx-font-size: 14; -fx-padding: 0 20;" />
        </VBox>

        <!-- Remember-Me -->
        <CheckBox fx:id="rememberMe" text="Se souvenir de moi"
                  style="-fx-text-fill: #6B7280; -fx-font-size: 14;" />

        <!-- ================================================================ -->
        <!--  🛡️ SECTION CAPTCHA                                              -->
        <!-- ================================================================ -->
        <VBox spacing="9"
              style="-fx-background-color: #FAFAFA; -fx-border-color: #E5E7EB;
                     -fx-border-width: 1.5; -fx-border-radius: 12; -fx-background-radius: 12;
                     -fx-padding: 14;">

            <!-- Titre section -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #374151;"
                       text="🛡️  Vérification de sécurité" />
                <Label style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;"
                       text="— Prouvez que vous n'êtes pas un robot" />
            </HBox>

            <!-- Canvas CAPTCHA + bouton Rafraîchir -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <!-- Le Pane reçoit le Canvas rendu dynamiquement par le controller -->
                <Pane fx:id="captchaPane"
                      prefWidth="230" prefHeight="65"
                      style="-fx-background-color: transparent;" />

                <!-- Bouton rafraîchir -->
                <Button fx:id="btnRefreshCaptcha"
                        onAction="#handleRefreshCaptcha"
                        prefWidth="46" prefHeight="46"
                        style="-fx-background-color: #F3F0FF; -fx-text-fill: #7C3AED;
                               -fx-font-size: 20; -fx-background-radius: 50;
                               -fx-border-color: #DDD6FE; -fx-border-width: 1.5;
                               -fx-border-radius: 50; -fx-cursor: hand;"
                        text="↻" />
            </HBox>

            <!-- Champ saisie CAPTCHA -->
            <VBox spacing="4">
                <TextField fx:id="captchaInput"
                           promptText="Tapez les caractères affichés  (insensible à la casse)"
                           prefHeight="44"
                           style="-fx-background-color: white; -fx-border-color: #D1D5DB;
                                  -fx-border-width: 1.5; -fx-border-radius: 10;
                                  -fx-background-radius: 10; -fx-text-fill: #1F2937;
                                  -fx-font-size: 15; -fx-font-weight: bold;
                                  -fx-padding: 0 15; -fx-alignment: CENTER;" />
                <!-- Erreur CAPTCHA inline -->
                <Label fx:id="captchaErrorLabel"
                       style="-fx-text-fill: #EF4444; -fx-font-size: 12; -fx-font-weight: bold;"
                       visible="false" />
            </VBox>
        </VBox>
        <!-- ================================================================ -->

        <!-- Bouton connexion -->
        <Button fx:id="btnLogin" onAction="#handleLogin"
                prefHeight="50" prefWidth="350"
                style="-fx-background-color: linear-gradient(to right, #8B5CF6, #7C3AED);
                       -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;
                       -fx-background-radius: 12; -fx-cursor: hand;"
                text="Se connecter" />

        <!-- Lien inscription -->
        <HBox alignment="CENTER" spacing="5">
            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 14;" text="Pas encore de compte ?" />
            <Hyperlink fx:id="linkToRegister"
                       style="-fx-font-size: 14; -fx-text-fill: #8B5CF6; -fx-font-weight: bold;"
                       text="S'inscrire" />
        </HBox>

        <!-- Label erreur global -->
        <Label fx:id="errorLabel"
               wrapText="true" maxWidth="350"
               style="-fx-text-fill: #EF4444; -fx-font-size: 13; -fx-font-weight: bold;
                      -fx-background-color: #FEE2E2; -fx-padding: 10 15; -fx-background-radius: 8;"
               visible="false" />
    </VBox>
</AnchorPane>
