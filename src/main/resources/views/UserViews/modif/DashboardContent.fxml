<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Contenu dashboard — chargé dans le StackPane contentArea de DashboardAdmin.fxml.
    Fond transparent : backgLIGHT.png est déjà appliqué sur le StackPane parent.

    ✅ CORRECTIONS APPORTÉES :
    1. xmlns="http://javafx.com/javafx/21"   → aligné avec le runtime JavaFX 21 du pom.xml
    2. Tous les linear-gradient(135deg, ...) remplacés par la syntaxe JavaFX 21 :
       linear-gradient(from 0% 0% to 100% 100%, couleur1, couleur2)
-->
<AnchorPane prefHeight="700" prefWidth="940"
            style="-fx-background-color: transparent;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.UserControlleers.modifControl.DashboardContentController">

    <VBox spacing="32" alignment="TOP_LEFT"
          AnchorPane.topAnchor="50" AnchorPane.leftAnchor="50"
          AnchorPane.rightAnchor="30" AnchorPane.bottomAnchor="30">

        <!-- ── En-tête ─────────────────────────────────────────────── -->
        <VBox spacing="8">
            <Label style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #1F2937;"
                   text="Tableau de Bord Administrateur" />
            <Label style="-fx-font-size: 15; -fx-text-fill: #6B7280;"
                   text="Bienvenue sur votre espace de gestion" />
        </VBox>

        <!-- ── Statistiques ────────────────────────────────────────── -->
        <HBox spacing="24">

            <!-- Card Utilisateurs -->
            <!-- ✅ CORRIGÉ : linear-gradient(135deg,...) → syntaxe JavaFX 21 -->
            <VBox alignment="CENTER" prefHeight="150" prefWidth="240" spacing="14"
                  style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea, #764ba2);
                         -fx-background-radius: 18;
                         -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.18),14,0,0,6);
                         -fx-padding: 25;">
                <Label style="-fx-font-size: 38;" text="👥" />
                <VBox alignment="CENTER" spacing="3">
                    <Label style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.88);" text="Utilisateurs" />
                    <Label fx:id="labelTotalUsers"
                           style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: white;" text="--" />
                </VBox>
            </VBox>

            <!-- Card Nouveaux (30j) -->
            <!-- ✅ CORRIGÉ -->
            <VBox alignment="CENTER" prefHeight="150" prefWidth="240" spacing="14"
                  style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea, #764ba2);
                         -fx-background-radius: 18;
                         -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.18),14,0,0,6);
                         -fx-padding: 25;">
                <Label style="-fx-font-size: 38;" text="📈" />
                <VBox alignment="CENTER" spacing="3">
                    <Label style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.88);" text="Nouveaux (30j)" />
                    <Label fx:id="labelNewUsers"
                           style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: white;" text="--" />
                </VBox>
            </VBox>

            <!-- Card Actifs -->
            <!-- ✅ CORRIGÉ -->
            <VBox alignment="CENTER" prefHeight="150" prefWidth="240" spacing="14"
                  style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea, #764ba2);
                         -fx-background-radius: 18;
                         -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.18),14,0,0,6);
                         -fx-padding: 25;">
                <Label style="-fx-font-size: 38;" text="⚡" />
                <VBox alignment="CENTER" spacing="3">
                    <Label style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.88);" text="Actifs" />
                    <Label fx:id="labelActiveUsers"
                           style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: white;" text="--" />
                </VBox>
            </VBox>
        </HBox>

        <!-- ── Actions Rapides ──────────────────────────────────────── -->
        <VBox spacing="14">
            <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1F2937;"
                   text="Actions Rapides" />

            <HBox spacing="20">
                <!-- Card Gestion Utilisateurs -->
                <VBox alignment="TOP_LEFT" prefHeight="185" prefWidth="400" spacing="18"
                      style="-fx-background-color: rgba(255,255,255,0.88);
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.08),10,0,0,4);
                             -fx-padding: 24;
                             -fx-cursor: hand;">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label style="-fx-font-size: 34;" text="👥" />
                        <VBox spacing="3">
                            <Label style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1F2937;"
                                   text="Gestion des Utilisateurs" />
                            <Label style="-fx-font-size: 12; -fx-text-fill: #6B7280;"
                                   text="Gérer tous les comptes utilisateurs" />
                        </VBox>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS" />
                    <Button onAction="#openGestionUsers" prefHeight="42" prefWidth="352"
                            style="-fx-background-color: #8B5CF6; -fx-text-fill: white;
                                   -fx-font-size: 14; -fx-font-weight: bold;
                                   -fx-background-radius: 10; -fx-cursor: hand;
                                   -fx-effect: dropshadow(three-pass-box,rgba(139,92,246,0.35),10,0,0,3);"
                            text="Ouvrir →" />
                </VBox>
            </HBox>
        </VBox>

        <!-- ── Footer ──────────────────────────────────────────────── -->
        <Region VBox.vgrow="ALWAYS" />
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label style="-fx-font-size: 14;" text="ℹ" />
            <Label style="-fx-font-size: 12; -fx-text-fill: #9CA3AF;"
                   text="Connecté en tant qu'administrateur" />
        </HBox>

    </VBox>
</AnchorPane>
