<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700" prefWidth="931.0"
            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea, #764ba2);"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.UserControlleers.ForgotPasswordController">

    <VBox alignment="CENTER" layoutX="241.0" layoutY="100.0" prefWidth="450" spacing="28"
          style="-fx-background-color: white; -fx-background-radius: 20;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 25, 0, 0, 10);">
        <padding>
            <Insets bottom="50" left="50" right="50" top="50" />
        </padding>

        <!-- Icône / En-tête -->
        <VBox alignment="CENTER" spacing="10">
            <Label style="-fx-font-size: 48;" text="🔑" />
            <Label style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1F2937;"
                   text="Mot de passe oublié ?" />
            <Label wrapText="true" maxWidth="350"
                   style="-fx-font-size: 14; -fx-text-fill: #6B7280; -fx-text-alignment: center;"
                   text="Entrez votre adresse email et nous vous enverrons un code de vérification." />
        </VBox>

        <!-- Champ Email -->
        <VBox spacing="6">
            <Label style="-fx-font-size: 14; -fx-text-fill: #374151; -fx-font-weight: bold;" text="Adresse email" />
            <TextField fx:id="emailField"
                       promptText="votre.email@exemple.com"
                       prefHeight="50"
                       style="-fx-background-color: #F3F4F6; -fx-background-radius: 12;
                              -fx-text-fill: #1F2937; -fx-font-size: 14; -fx-padding: 0 20;" />
        </VBox>

        <!-- Message d'erreur / succès -->
        <Label fx:id="messageLabel"
               wrapText="true" maxWidth="350"
               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 15; -fx-background-radius: 8;"
               visible="false" />

        <!-- Bouton Envoyer -->
        <Button fx:id="btnEnvoyer"
                onAction="#handleEnvoyerCode"
                prefHeight="50" prefWidth="350"
                style="-fx-background-color: linear-gradient(to right, #8B5CF6, #7C3AED);
                       -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;
                       -fx-background-radius: 12; -fx-cursor: hand;"
                text="Envoyer le code" />

        <!-- Retour Login -->
        <HBox alignment="CENTER" spacing="5">
            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 14;" text="Vous vous souvenez ?" />
            <Hyperlink fx:id="linkRetourLogin"
                       style="-fx-font-size: 14; -fx-text-fill: #8B5CF6; -fx-font-weight: bold;"
                       text="Se connecter" />
        </HBox>
    </VBox>
</AnchorPane>
