<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700" prefWidth="931.0"
            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea, #764ba2);"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.UserControlleers.ResetPasswordController">

    <VBox alignment="CENTER" layoutX="241.0" layoutY="70.0" prefWidth="450" spacing="25"
          style="-fx-background-color: white; -fx-background-radius: 20;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 25, 0, 0, 10);">
        <padding>
            <Insets bottom="50" left="50" right="50" top="50" />
        </padding>

        <!-- En-tête -->
        <VBox alignment="CENTER" spacing="10">
            <Label style="-fx-font-size: 48;" text="🔒" />
            <Label style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1F2937;"
                   text="Nouveau mot de passe" />
            <Label wrapText="true" maxWidth="350"
                   style="-fx-font-size: 14; -fx-text-fill: #6B7280; -fx-text-alignment: center;"
                   text="Choisissez un nouveau mot de passe sécurisé." />
        </VBox>

        <!-- Nouveau mot de passe -->
        <VBox spacing="6">
            <Label style="-fx-font-size: 14; -fx-text-fill: #374151; -fx-font-weight: bold;"
                   text="Nouveau mot de passe" />
            <PasswordField fx:id="newPasswordField"
                           promptText="••••••••"
                           prefHeight="50"
                           style="-fx-background-color: #F3F4F6; -fx-background-radius: 12;
                                  -fx-text-fill: #1F2937; -fx-font-size: 14; -fx-padding: 0 20;" />

            <!-- Indicateur de force (même style que l'inscription) -->
            <HBox fx:id="strengthContainer" alignment="CENTER_LEFT" prefHeight="20" spacing="10">
                <HBox prefHeight="6" prefWidth="350" style="-fx-background-color: #E5E7EB; -fx-background-radius: 5;">
                    <Region fx:id="strengthBar" prefHeight="6" prefWidth="0" style="-fx-background-radius: 5;" />
                </HBox>
                <Label fx:id="strengthLabel" style="-fx-font-size: 12; -fx-font-weight: bold;" />
            </HBox>
        </VBox>

        <!-- Confirmation mot de passe -->
        <VBox spacing="6">
            <Label style="-fx-font-size: 14; -fx-text-fill: #374151; -fx-font-weight: bold;"
                   text="Confirmer le mot de passe" />
            <PasswordField fx:id="confirmPasswordField"
                           promptText="••••••••"
                           prefHeight="50"
                           style="-fx-background-color: #F3F4F6; -fx-background-radius: 12;
                                  -fx-text-fill: #1F2937; -fx-font-size: 14; -fx-padding: 0 20;" />
        </VBox>

        <!-- Conseils -->
        <VBox spacing="3" style="-fx-background-color: #F0F9FF; -fx-padding: 10; -fx-background-radius: 8;">
            <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #1E40AF;" text="💡 Mot de passe fort requis :" />
            <Label style="-fx-font-size: 10; -fx-text-fill: #3B82F6;" text="• Min 8 caractères" />
            <Label style="-fx-font-size: 10; -fx-text-fill: #3B82F6;" text="• 1 majuscule, 1 minuscule, 1 chiffre" />
            <Label style="-fx-font-size: 10; -fx-text-fill: #3B82F6;" text="• Caractères spéciaux recommandés" />
        </VBox>

        <!-- Message erreur/succès -->
        <Label fx:id="messageLabel"
               wrapText="true" maxWidth="350"
               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 15; -fx-background-radius: 8;"
               visible="false" />

        <!-- Bouton Réinitialiser -->
        <Button fx:id="btnReinitialiser"
                onAction="#handleReinitialiser"
                prefHeight="50" prefWidth="350"
                style="-fx-background-color: linear-gradient(to right, #8B5CF6, #7C3AED);
                       -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;
                       -fx-background-radius: 12; -fx-cursor: hand;"
                text="Réinitialiser le mot de passe" />
    </VBox>
</AnchorPane>
