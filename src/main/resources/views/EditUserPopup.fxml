<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="580" prefWidth="520" style="-fx-background-color: #F9FAFB;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.EditUserPopupController">

    <!-- Container principal -->
    <VBox layoutX="0" layoutY="0" prefHeight="580" prefWidth="520" spacing="0">
        
        <!-- Header avec dégradé -->
        <HBox alignment="CENTER_LEFT" prefHeight="100" spacing="15" style="-fx-background-color: linear-gradient(to right, #8B5CF6, #7C3AED); -fx-padding: 25 30;">
            <Label style="-fx-font-size: 36;" text="🔧" />
            <VBox spacing="3">
                <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;" text="Modifier l'utilisateur" />
                <Label style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.8);" text="Mettez à jour les informations" />
            </VBox>
        </HBox>

        <!-- Formulaire -->
        <VBox spacing="20" style="-fx-padding: 30;">
            
            <!-- Nom et Prénom -->
            <HBox spacing="15">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Nom" />
                    <TextField fx:id="nomField" prefHeight="45" promptText="Nom" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 14; -fx-padding: 12;" />
                </VBox>
                
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Prénom" />
                    <TextField fx:id="prenomField" prefHeight="45" promptText="Prénom" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 14; -fx-padding: 12;" />
                </VBox>
            </HBox>

            <!-- Email -->
            <VBox spacing="8">
                <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Email" />
                <TextField fx:id="emailField" prefHeight="45" promptText="Email" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 14; -fx-padding: 12;" />
            </VBox>

            <!-- Date de naissance -->
            <VBox spacing="8">
                <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Date de naissance" />
                <DatePicker fx:id="dateNaissanceField" prefHeight="45" promptText="Date de naissance" style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 14;" />
            </VBox>

            <!-- Informations statiques -->
            <VBox spacing="12" style="-fx-background-color: #EDE9FE; -fx-padding: 15; -fx-background-radius: 12;">
                <Label fx:id="roleLabel" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #6D28D9;" text="Rôle : ETUDIANT" />
                <Label fx:id="dateInscriptionLabel" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #7C3AED;" text="Date d'inscription : 2024-01-15" />
            </VBox>

            <!-- Boutons d'action -->
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="btnCancel" onAction="#closeWindow" prefHeight="48" prefWidth="200" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: #D1D5DB; -fx-border-width: 1.5; -fx-border-radius: 12;" text="❌" />
                
                <Button fx:id="btnSave" onAction="#saveChanges" prefHeight="48" prefWidth="200" style="-fx-background-color: linear-gradient(to right, #10B981, #059669); -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(16, 185, 129, 0.3), 10, 0, 0, 3);" text="✔ Enregistrer" />
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>
