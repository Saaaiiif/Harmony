<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx/21"
            fx:controller="controllers.ForumControllers.AddCommentController"
            prefWidth="440"
            prefHeight="320"
            stylesheets="@/views/UserViews/modif/admin-styles.css"
            style="-fx-background-color: white;">

    <VBox spacing="16" alignment="TOP_CENTER"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="💬" style="-fx-font-size: 22px;"/>
            <Label text="Ajouter un commentaire"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
        </HBox>

        <Separator/>

        <!-- CONTENU -->
        <VBox spacing="6" VBox.vgrow="ALWAYS">
            <Label text="Votre commentaire"
                   style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 13px;"/>
            <TextArea fx:id="contenuField"
                      promptText="Écrivez votre commentaire ici..."
                      prefHeight="130"
                      wrapText="true"
                      style="-fx-background-radius: 8; -fx-border-radius: 8;
                             -fx-border-color: #e5e7eb; -fx-font-size: 13px;
                             -fx-control-inner-background: white;"/>
        </VBox>

        <Separator/>

        <!-- ACTIONS -->
        <HBox spacing="12">
            <Button fx:id="backBtn"
                    text="← Annuler"
                    onAction="#handleBack"
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity"
                    style="-fx-background-color: #f3f4f6; -fx-text-fill: #6b7280;
                           -fx-background-radius: 8; -fx-border-radius: 8;
                           -fx-padding: 12; -fx-font-size: 13px; -fx-cursor: hand;"/>

            <Button text="Publier ✓"
                    onAction="#handleSubmit"
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity"
                    style="-fx-background-color: #7c3aed; -fx-text-fill: white;
                           -fx-background-radius: 8; -fx-border-radius: 8;
                           -fx-font-weight: bold; -fx-padding: 12;
                           -fx-font-size: 13px; -fx-cursor: hand;"/>
        </HBox>

    </VBox>

</AnchorPane>
