<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ForumControllers.BackOffice.EditCategorieController"
      prefWidth="420"
      style="-fx-background-color: white; -fx-background-radius: 16;">

    <!-- Header violet -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #7c3aed, #a855f7);
                 -fx-background-radius: 16 16 0 0; -fx-padding: 18 24;">
        <Label text="🗂" style="-fx-font-size: 20px;"/>
        <Label text="Modifier la Catégorie"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>

    <!-- Corps -->
    <VBox spacing="16" style="-fx-padding: 24; -fx-background-color: #fafafa;
                               -fx-background-radius: 0 0 16 16;">

        <!-- Champ Nom -->
        <VBox spacing="6">
            <Label text="Nom de la catégorie"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <TextField fx:id="nomField"
                       promptText="Ex: Programmation, Design..."
                       style="-fx-background-color: white; -fx-border-color: #e5e7eb;
                              -fx-border-radius: 8; -fx-background-radius: 8;
                              -fx-border-width: 1.5; -fx-padding: 10 14;
                              -fx-font-size: 13px; -fx-text-fill: #111827;"/>
        </VBox>

        <!-- Champ Description -->
        <VBox spacing="6">
            <Label text="Description"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <TextArea fx:id="descriptionField"
                      promptText="Décrivez cette catégorie..."
                      prefHeight="100"
                      wrapText="true"
                      style="-fx-background-color: white; -fx-border-color: #e5e7eb;
                             -fx-border-radius: 8; -fx-background-radius: 8;
                             -fx-border-width: 1.5; -fx-padding: 10 14;
                             -fx-font-size: 13px; -fx-text-fill: #111827;"/>
        </VBox>

        <!-- Bouton Enregistrer -->
        <Button text="💾  Enregistrer les modifications"
                onAction="#handleSave"
                maxWidth="Infinity"
                style="-fx-background-color: #7c3aed; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-font-size: 13px;
                       -fx-background-radius: 10; -fx-padding: 12 20; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian,rgba(124,58,237,0.35),8,0,0,3);"/>

    </VBox>
</VBox>
