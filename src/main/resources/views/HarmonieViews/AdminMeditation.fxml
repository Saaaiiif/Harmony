<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.MeditationControllers.AdminMeditationController"
      spacing="20" styleClass="content-area" stylesheets="@harmonie-style.css">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Sessions de Méditation" styleClass="title-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Nouvelle Session" styleClass="btn-primary" onAction="#showAddForm"/>
    </HBox>

    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="filter-bar">
        <TextField fx:id="searchField" promptText="🔍 Rechercher par thème, auteur..."
                   styleClass="text-field" HBox.hgrow="ALWAYS" onKeyReleased="#onSearchChanged"/>
        <ComboBox fx:id="sortCombo" promptText="Trier par..." onAction="#onSortChanged"
                  prefWidth="200"/>
    </HBox>

    <VBox fx:id="formSection" visible="false" managed="false" styleClass="harmonie-card" spacing="15">
        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
        <Label fx:id="formTitle" text="Ajouter une Session" styleClass="section-title"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Thème"/>
                <HBox spacing="10">
                    <TextField fx:id="themeField" promptText="Ex: Relaxation, Stress, Sommeil..."
                               styleClass="text-field" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="generateAIBtn" text="✨ Générer avec IA"
                            styleClass="btn-primary" onAction="#generateWithAI"
                            style="-fx-font-size: 13px;"/>
                </HBox>
                <Label fx:id="themeError" styleClass="error-label" visible="false" managed="false"/>
                <Label fx:id="aiStatusLabel" text="" styleClass="subtitle-label"
                       visible="false" managed="false" style="-fx-font-size: 12px;"/>
            </VBox>
        </HBox>

        <HBox spacing="20">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Auteur"/>
                <TextField fx:id="auteurField" promptText="Nom de l'auteur" styleClass="text-field"/>
                <Label fx:id="auteurError" styleClass="error-label" visible="false" managed="false"/>
            </VBox>
        </HBox>

        <HBox spacing="20">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Durée (minutes)"/>
                <TextField fx:id="dureeField" promptText="Ex: 15" styleClass="text-field"/>
                <Label fx:id="dureeError" styleClass="error-label" visible="false" managed="false"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="URL Audio"/>
                <TextField fx:id="audioUrlField" promptText="Lien vers le fichier audio" styleClass="text-field"/>
                <Label fx:id="audioUrlError" styleClass="error-label" visible="false" managed="false"/>
            </VBox>
        </HBox>

        <VBox spacing="10">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Conseils"/>
                <Button text="+ Ajouter Conseil" onAction="#addConseilField"
                        style="-fx-font-size: 12px; -fx-background-color: #7C3AED; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 4 12; -fx-cursor: hand;"/>
            </HBox>
            <VBox fx:id="conseilsContainer" spacing="10"/>
            <Label fx:id="conseilsError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Annuler" styleClass="btn-secondary" onAction="#hideForm"/>
            <Button fx:id="submitBtn" text="Enregistrer" styleClass="btn-primary" onAction="#saveSession"/>
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="sessionsContainer" spacing="15">
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
        </VBox>
    </ScrollPane>

    <VBox fx:id="emptyState" alignment="CENTER" spacing="10" visible="false" managed="false" VBox.vgrow="ALWAYS">
        <Label text="🧘" style="-fx-font-size: 60px;"/>
        <Label text="Aucune session de méditation" styleClass="empty-state-text" style="-fx-font-size: 16px; -fx-text-fill: #6B7280;"/>
        <Button text="Créer la première session" styleClass="btn-primary" onAction="#showAddForm"/>
    </VBox>

</VBox>
