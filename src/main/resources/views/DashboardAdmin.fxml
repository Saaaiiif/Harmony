<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="650" prefWidth="1000" style="-fx-background-color: #E6E0F0;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DashboardAdminController">

    <!-- Sidebar -->
    <VBox layoutX="0" prefHeight="650" prefWidth="240" style="-fx-background-color: #F0E6FF;">
        <Label text="Harmony" style="-fx-font-size: 26; -fx-padding: 25; -fx-text-fill: #6A5ACD; -fx-font-weight: bold;"/>

        <Button text="Accueil" prefWidth="240" style="-fx-background-color: transparent; -fx-text-fill: #555; -fx-font-size: 15; -fx-padding: 12;"/>
        <Button text="Gestion Utilisateurs" prefWidth="240" onAction="#openGestionUsers"
                style="-fx-background-color: #6A5ACD; -fx-text-fill: white; -fx-font-size: 15; -fx-padding: 12;"/>
        <Button text="Statistiques" prefWidth="240" style="-fx-background-color: transparent; -fx-text-fill: #555; -fx-font-size: 15; -fx-padding: 12;"/>
        <Button text="Logs" prefWidth="240" style="-fx-background-color: transparent; -fx-text-fill: #555; -fx-font-size: 15; -fx-padding: 12;"/>
    </VBox>

    <!-- Contenu principal -->
    <Label layoutX="320" layoutY="180" text="Dashboard Administrateur"
           style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #6A5ACD;"/>
</AnchorPane>