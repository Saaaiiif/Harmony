<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="650" prefWidth="1000" style="-fx-background-color: #E6E0F0;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <Label layoutX="400" layoutY="200" text="Accueil Étudiant - Harmony"
           style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #6A5ACD;"/>

    <Label layoutX="400" layoutY="280" text="Bienvenue dans votre espace étudiant !"
           style="-fx-font-size: 18; -fx-text-fill: #555;"/>

    <!-- Sidebar placeholder (comme ton collègue) -->
    <VBox layoutX="0" prefHeight="650" prefWidth="220" style="-fx-background-color: #F0E6FF;">
        <Label text="Harmony" style="-fx-font-size: 24; -fx-padding: 20; -fx-text-fill: #6A5ACD; -fx-font-weight: bold;"/>
        <Button text="Accueil" prefWidth="220" style="-fx-background-color: transparent; -fx-text-fill: #6A5ACD;"/>
        <Button text="Planning" prefWidth="220" style="-fx-background-color: transparent; -fx-text-fill: #555;"/>
        <Button text="Santé Mentale" prefWidth="220" style="-fx-background-color: transparent; -fx-text-fill: #555;"/>
    </VBox>

</AnchorPane>
