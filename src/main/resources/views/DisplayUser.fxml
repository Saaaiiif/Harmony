<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="550" prefWidth="550" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DisplayUserController">

    <VBox layoutX="25.0" layoutY="25.0" prefWidth="500" spacing="25" style="-fx-padding: 35; -fx-background-color: white; -fx-background-radius: 25; -fx-effect: dropshadow(three-pass-box, rgba(139, 92, 246, 0.2), 30, 0, 0, 10); -fx-border-color: #E9D5FF; -fx-border-width: 2; -fx-border-radius: 25;">

        <HBox alignment="CENTER_LEFT" spacing="20">
            <!-- Avatar avec superposition image / initiale -->
            <StackPane fx:id="avatarContainer" prefHeight="70" prefWidth="70"
                       style="-fx-background-color: linear-gradient(to bottom right, #A78BFA, #8B5CF6); -fx-background-radius: 35; -fx-effect: dropshadow(three-pass-box, rgba(139, 92, 246, 0.4), 10, 0, 0, 4);">
                <Label fx:id="avatarLabel" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;" text="U" />
                <ImageView fx:id="profileImageView" fitHeight="70" fitWidth="70" pickOnBounds="true" preserveRatio="false" visible="false" />
            </StackPane>

            <VBox alignment="CENTER_LEFT" spacing="5">
                <Label fx:id="fullNameLabel" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1F2937;" text="Nom Prénom" />
                <Label fx:id="emailLabel" style="-fx-font-size: 14; -fx-text-fill: #6B7280;" text="email@example.com" />
            </VBox>
        </HBox>

        <VBox spacing="12">
            <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="📌 Informations Générales" />
            <FlowPane hgap="10" vgap="10">
                <Label fx:id="ageLabel" />
                <Label fx:id="dateNaissanceLabel" />
                <Label fx:id="roleLabel" />
                <Label fx:id="dateInscriptionLabel" />
            </FlowPane>
        </VBox>

        <VBox spacing="12">
            <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="⚕️ Profil Santé" />
            <FlowPane hgap="10" vgap="10">
                <Label fx:id="sexeLabel" />
                <Label fx:id="poidsLabel" />
                <Label fx:id="tailleLabel" />
                <Label fx:id="niveauActiviteLabel" />
            </FlowPane>
        </VBox>

        <VBox spacing="12">
            <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #4B5563;" text="🎓 Profil Scolaire" />
            <FlowPane hgap="10" vgap="10">
                <Label fx:id="niveauScolaireLabel" />
                <Label fx:id="etablissementLabel" />
            </FlowPane>
        </VBox>
    </VBox>
</AnchorPane>
