<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="500" style="-fx-background-color: linear-gradient(to bottom right, #F3E8FF, #E9D5FF);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DisplayUserController">

    <VBox layoutX="69.0" layoutY="46.0" spacing="20" style="-fx-padding: 30; -fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 25, 0, 0, 10);">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label style="-fx-font-size: 48;" text="👤" />
            <VBox spacing="3">
                <Label fx:id="fullNameLabel" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1F2937;" text="Nom Prénom" />
                <Label fx:id="emailLabel" style="-fx-font-size: 14; -fx-text-fill: #6B7280;" text="email@example.com" />
            </VBox>
        </HBox>

        <!-- Section Infos Personnelles -->
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Informations Personnelles" />
            <HBox spacing="20">
                <Label fx:id="ageLabel" style="-fx-font-size: 14; -fx-text-fill: #6B7280;" text="Âge: N/A" />
                <Label fx:id="dateNaissanceLabel" style="-fx-font-size: 14; -fx-text-fill: #6B7280;" text="Date Naissance: N/A" />
            </HBox>
            <Label fx:id="dateInscriptionLabel" style="-fx-font-size: 14; -fx-text-fill: #6B7280;" text="Date Inscription: N/A" />
            <Label fx:id="roleLabel" style="-fx-font-size: 14; -fx-text-fill: #6B7280;" text="Rôle: N/A" />
        </VBox>

        <!-- Section Santé -->
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Informations Santé" />
            <HBox spacing="20">
                <Label fx:id="sexeLabel" style="-fx-font-size: 14; -fx-text-fill: #6B7280;" text="Sexe: N/A" />
                <Label fx:id="poidsLabel" style="-fx-font-size: 14; -fx-text-fill: #6B7280;" text="Poids: N/A" />
                <Label fx:id="tailleLabel" style="-fx-font-size: 14; -fx-text-fill: #6B7280;" text="Taille: N/A" />
            </HBox>
            <Label fx:id="niveauActiviteLabel" style="-fx-font-size: 14; -fx-text-fill: #6B7280;" text="Niveau Activité: N/A" />
        </VBox>

        <!-- Section Scolaire -->
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Informations Scolaires" />
            <Label fx:id="niveauScolaireLabel" style="-fx-font-size: 14; -fx-text-fill: #6B7280;" text="Niveau Scolaire: N/A" />
            <Label fx:id="etablissementLabel" style="-fx-font-size: 14; -fx-text-fill: #6B7280;" text="Établissement: N/A" />
        </VBox>
    </VBox>
</AnchorPane>
