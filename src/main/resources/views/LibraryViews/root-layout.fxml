<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane
        fx:id="root"
        xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.LibraryControllers.RootLayoutController"
            prefWidth="1200" prefHeight="700"
            styleClass="root">

    <top>
        <!-- Custom Title Bar -->
        <HBox fx:id="titleBar" alignment="CENTER_RIGHT" styleClass="title-bar">
            <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <ImageView fx:id="logoImage" fitHeight="30" fitWidth="30" preserveRatio="true">
                    <HBox.margin>
                        <Insets left="20" right="5"/>
                    </HBox.margin>
                </ImageView>
                <Label text="Harmony" styleClass="title-label"/>
            </HBox>

            <Button fx:id="themeToggleButton" text="☀" styleClass="window-control-button"/>
            <Button fx:id="minimizeButton" text="—" styleClass="window-control-button"/>
            <Button fx:id="closeButton" text="✕" styleClass="window-control-button"/>
        </HBox>
    </top>

    <center>
        <!-- Content area where other views will be loaded -->
        <StackPane fx:id="contentArea"/>
    </center>

</BorderPane>
