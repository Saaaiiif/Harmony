<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<!--
    EtudiantProfilePopup.fxml — Popup de modification du profil Étudiant
    Inspiré de AdminProfilePopup.fxml, avec les champs supplémentaires
    propres aux étudiants (poids, taille, activité, niveau scolaire, établissement).
-->
<VBox alignment="TOP_CENTER" spacing="0" prefWidth="580"
      style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.EtudiantProfilePopupController">

    <!-- ── En-tête dégradé violet (même style que côté admin) ── -->
    <VBox alignment="CENTER" spacing="14"
          style="-fx-background-color: linear-gradient(135deg, #667eea, #764ba2); -fx-padding: 28 40;">

        <!-- Avatar circulaire cliquable -->
        <StackPane fx:id="popupAvatarContainer"
                   prefWidth="80" prefHeight="80"
                   style="-fx-background-color: rgba(255,255,255,0.25);
                          -fx-background-radius: 40;
                          -fx-cursor: hand;"
                   onMouseClicked="#handleChangeImage">

            <Label fx:id="popupAvatarInitial"
                   style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;"
                   text="E"/>
            <ImageView fx:id="popupAvatarImage"
                       fitWidth="80" fitHeight="80"
                       preserveRatio="false"
                       visible="false">
                <clip><Circle centerX="40" centerY="40" radius="40"/></clip>
            </ImageView>

            <!-- Badge modifier photo -->
            <Label text="✎"
                   style="-fx-font-size: 14; -fx-text-fill: white; -fx-background-color: #8B5CF6;
                          -fx-background-radius: 12; -fx-padding: 2 6;
                          -fx-translate-x: 26; -fx-translate-y: 26;"/>
        </StackPane>

        <VBox alignment="CENTER" spacing="2">
            <Label fx:id="headerName"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"
                   text="Étudiant"/>
            <Label style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.75);"
                   text="Cliquez sur l'avatar pour changer la photo"/>
        </VBox>
    </VBox>

    <!-- ── Formulaire scrollable ── -->
    <ScrollPane fitToWidth="true" prefHeight="460"
                style="-fx-background: white; -fx-background-color: white; -fx-border-width: 0;">
        <VBox spacing="16" style="-fx-padding: 24 40 10 40;">

            <!-- ── Prénom / Nom ── -->
            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Prénom *"/>
                    <TextField fx:id="fieldPrenom" prefHeight="42" promptText="Prénom"
                               style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB;
                                      -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-font-size: 13; -fx-padding: 10;"/>
                    <Label fx:id="errorPrenom" style="-fx-text-fill: #EF4444; -fx-font-size: 10;" visible="false"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Nom *"/>
                    <TextField fx:id="fieldNom" prefHeight="42" promptText="Nom"
                               style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB;
                                      -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-font-size: 13; -fx-padding: 10;"/>
                    <Label fx:id="errorNom" style="-fx-text-fill: #EF4444; -fx-font-size: 10;" visible="false"/>
                </VBox>
            </HBox>

            <!-- ── Email ── -->
            <VBox spacing="6">
                <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Adresse email *"/>
                <TextField fx:id="fieldEmail" prefHeight="42" promptText="email@exemple.com"
                           style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB;
                                  -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-font-size: 13; -fx-padding: 10;"/>
                <Label fx:id="errorEmail" style="-fx-text-fill: #EF4444; -fx-font-size: 10;" visible="false"/>
            </VBox>

            <!-- ── Date de naissance / Sexe ── -->
            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Date de naissance"/>
                    <DatePicker fx:id="fieldDateNaissance" prefHeight="42" prefWidth="230"
                                style="-fx-font-size: 13;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Sexe"/>
                    <ComboBox fx:id="fieldSexe" prefHeight="42" prefWidth="230"
                              style="-fx-font-size: 13;"/>
                </VBox>
            </HBox>

            <!-- ── Séparateur Infos physiques ── -->
            <VBox style="-fx-background-color: #EDE9FE; -fx-background-radius: 8; -fx-padding: 10 14;">
                <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #6D28D9;"
                       text="📊  Informations physiques"/>
            </VBox>

            <!-- ── Poids / Taille ── -->
            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Poids (kg)"/>
                    <TextField fx:id="fieldPoids" prefHeight="42" promptText="ex: 70.5"
                               style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB;
                                      -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-font-size: 13; -fx-padding: 10;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Taille (cm)"/>
                    <TextField fx:id="fieldTaille" prefHeight="42" promptText="ex: 175"
                               style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB;
                                      -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-font-size: 13; -fx-padding: 10;"/>
                </VBox>
            </HBox>

            <!-- ── Niveau activité physique ── -->
            <VBox spacing="6">
                <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"
                       text="Niveau d'activité physique"/>
                <ComboBox fx:id="fieldActivite" prefHeight="42" prefWidth="Infinity"
                          style="-fx-font-size: 13;"/>
            </VBox>

            <!-- ── Séparateur Infos scolaires ── -->
            <VBox style="-fx-background-color: #EDE9FE; -fx-background-radius: 8; -fx-padding: 10 14;">
                <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #6D28D9;"
                       text="🎓  Informations scolaires"/>
            </VBox>

            <!-- ── Niveau scolaire / Établissement ── -->
            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Niveau scolaire"/>
                    <ComboBox fx:id="fieldNiveauScolaire" prefHeight="42" prefWidth="230"
                              style="-fx-font-size: 13;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Établissement"/>
                    <TextField fx:id="fieldEtablissement" prefHeight="42" promptText="Votre établissement"
                               style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB;
                                      -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-font-size: 13; -fx-padding: 10;"/>
                </VBox>
            </HBox>

            <!-- ── Séparateur mot de passe ── -->
            <VBox spacing="6"
                  style="-fx-background-color: #F3F4F6; -fx-background-radius: 8; -fx-padding: 12;">
                <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"
                       text="🔒 Changer le mot de passe (optionnel)"/>
                <Label style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;"
                       text="Laissez vide pour conserver l'actuel."/>
            </VBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Nouveau mot de passe"/>
                    <PasswordField fx:id="fieldPassword" prefHeight="42" promptText="••••••••"
                                   style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB;
                                          -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-font-size: 13; -fx-padding: 10;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"
                           text="Confirmer"/>
                    <PasswordField fx:id="fieldPasswordConfirm" prefHeight="42" promptText="••••••••"
                                   style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB;
                                          -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-font-size: 13; -fx-padding: 10;"/>
                </VBox>
            </HBox>
            <Label fx:id="errorPassword" style="-fx-text-fill: #EF4444; -fx-font-size: 10;" visible="false"/>

            <!-- Message global (succès / erreur) -->
            <Label fx:id="globalMessage"
                   wrapText="true" prefWidth="480"
                   style="-fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 4 0;"
                   visible="false"/>

        </VBox>
    </ScrollPane>

    <!-- ── Boutons d'action (même style que côté admin) ── -->
    <HBox alignment="CENTER" spacing="14"
          style="-fx-background-color: #F9FAFB; -fx-padding: 16 40;
                 -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;">

        <Button onAction="#handleAnnuler"
                prefHeight="44" prefWidth="160"
                style="-fx-background-color: white; -fx-text-fill: #374151; -fx-font-size: 13;
                       -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;
                       -fx-border-color: #D1D5DB; -fx-border-width: 1.5; -fx-border-radius: 10;"
                text="Annuler"/>

        <Button fx:id="btnSupprPhoto" onAction="#handleSupprimerPhoto"
                prefHeight="44" prefWidth="170"
                style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626; -fx-font-size: 13;
                       -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"
                text="🗑  Suppr. photo"/>

        <Button fx:id="btnSauvegarder" onAction="#handleSauvegarder"
                prefHeight="44" prefWidth="180"
                style="-fx-background-color: linear-gradient(to right, #8B5CF6, #7C3AED);
                       -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;
                       -fx-background-radius: 10; -fx-cursor: hand;
                       -fx-effect: dropshadow(three-pass-box, rgba(139,92,246,0.4), 10, 0, 0, 3);"
                text="✓  Sauvegarder"/>
    </HBox>

</VBox>
