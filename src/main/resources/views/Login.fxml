<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700" prefWidth="931.0" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LoginController">

    <VBox alignment="CENTER" layoutX="241.0" layoutY="33.0" prefWidth="450" spacing="25" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 25, 0, 0, 10);">
        <padding>
            <Insets bottom="50" left="50" right="50" top="50" />
        </padding>

        <VBox alignment="CENTER" spacing="8">
            <Label style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #1F2937;" text="Bienvenue sur Harmony" />
            <Label style="-fx-font-size: 15; -fx-text-fill: #6B7280;" text="Connectez-vous pour accéder à votre compte" />
        </VBox>

        <VBox spacing="6">
            <Label style="-fx-font-size: 14; -fx-text-fill: #374151; -fx-font-weight: bold;" text="Email" />
            <TextField fx:id="emailLogin" prefHeight="50" style="-fx-background-color: #F3F4F6; -fx-background-radius: 12; -fx-text-fill: #1F2937; -fx-font-size: 14; -fx-padding: 0 20;" />
        </VBox>

        <VBox spacing="6">
            <Label style="-fx-font-size: 14; -fx-text-fill: #374151; -fx-font-weight: bold;" text="Mot de passe" />
            <PasswordField fx:id="passwordLogin" prefHeight="50" style="-fx-background-color: #F3F4F6; -fx-background-radius: 12; -fx-text-fill: #1F2937; -fx-font-size: 14; -fx-padding: 0 20;" />
        </VBox>

        <!-- Remember-Me -->
        <CheckBox fx:id="rememberMe" text="Se souvenir de moi" style="-fx-text-fill: #6B7280; -fx-font-size: 14;" />

        <Button fx:id="btnLogin" onAction="#handleLogin" prefHeight="50" prefWidth="350" style="-fx-background-color: linear-gradient(to right, #8B5CF6, #7C3AED); -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Se connecter" />

        <HBox alignment="CENTER" spacing="5">
            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 14;" text="Pas encore de compte ?" />
            <Hyperlink fx:id="linkToRegister" style="-fx-font-size: 14; -fx-text-fill: #8B5CF6; -fx-font-weight: bold;" text="S'inscrire" />
        </HBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #EF4444; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-color: #FEE2E2; -fx-padding: 10 15; -fx-background-radius: 8;" visible="false" />
    </VBox>
</AnchorPane>