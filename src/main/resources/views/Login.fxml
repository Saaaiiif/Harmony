<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650" prefWidth="1000" style="-fx-background-color: #E6E0F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LoginController">

    <!-- Contenu centré -->
    <VBox alignment="CENTER" layoutX="190.0" layoutY="80.0" prefHeight="500" prefWidth="620" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15;                  -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 15, 0, 0, 0);">

        <padding>
            <Insets bottom="50" left="80" right="80" top="60" />
        </padding>

        <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #6A5ACD;" text="Bienvenue sur Harmony" />

        <TextField fx:id="emailLogin" prefWidth="420" promptText="Email" style="-fx-font-size: 15;" />
        <PasswordField fx:id="passwordLogin" prefWidth="420" promptText="Mot de passe" style="-fx-font-size: 15;" />

        <Button fx:id="btnLogin" onAction="#handleLogin" prefWidth="420" style="-fx-background-color: #6A5ACD; -fx-text-fill: white; -fx-font-size: 16;                        -fx-font-weight: bold; -fx-background-radius: 10;" text="Se connecter" />

        <!-- Lien vers inscription -->
        <Hyperlink fx:id="linkToRegister" style="-fx-font-size: 15; -fx-text-fill: #6A5ACD;" text="Pas encore de compte ? S'inscrire" />

        <Label fx:id="errorLabel" style="-fx-text-fill: red; -fx-font-size: 14;" visible="false" />
    </VBox>

    <!-- Titre en haut à gauche -->
    <Label layoutX="14.0" layoutY="14.0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #6A5ACD; -fx-font-style: italic;" text="Harmony" />

</AnchorPane>
