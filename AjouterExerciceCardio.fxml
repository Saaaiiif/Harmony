<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="720.0" prefWidth="1080.0" alignment="CENTER" styleClass="neon-background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterExerciceCardioController">
    <children>
        <VBox alignment="CENTER" spacing="25.0" maxWidth="750.0" styleClass="glass-form-card">
            <padding>
                <Insets top="40.0" right="60.0" bottom="40.0" left="60.0"/>
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="5">
                    <Label text="⚡ Séquence Cardio" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(three-pass-box, #d500f9, 15, 0, 0, 0);" />
                    <Label text="Paramétrez votre module d'endurance." style="-fx-text-fill: #e1bee7; -fx-font-size: 15px;" />
                </VBox>

                <VBox spacing="20.0" maxWidth="600.0">

                    <VBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="RECHERCHER UN EXERCICE CARDIO" styleClass="neon-label"/>
                        <TextField fx:id="tfRecherche" promptText="🔍 Taper le nom de l'exercice (ex: Tapis)..." prefHeight="50.0" maxWidth="Infinity" styleClass="neon-input" />
                        <ListView fx:id="listResultats" prefHeight="120.0" maxWidth="Infinity" styleClass="neon-list" visible="false" managed="false" />
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="DATE DE SÉANCE" styleClass="neon-label"/>
                        <DatePicker fx:id="dpDate" prefHeight="50.0" maxWidth="Infinity" styleClass="neon-datepicker" />
                    </VBox>

                    <HBox spacing="30.0">
                        <VBox HBox.hgrow="ALWAYS" spacing="8" maxWidth="Infinity">
                            <Label text="DURÉE (MIN)" styleClass="neon-label"/>
                            <Spinner fx:id="spinnerDuree" prefHeight="50.0" maxWidth="Infinity" styleClass="neon-spinner" editable="true" />
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="8" maxWidth="Infinity">
                            <Label text="ÉNERGIE (KCAL)" styleClass="neon-label"/>
                            <Spinner fx:id="spinnerCalories" prefHeight="50.0" maxWidth="Infinity" styleClass="neon-spinner" editable="true" />
                        </VBox>
                    </HBox>

                    <VBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="DONNÉES BIOMÉTRIQUES / RESSENTI" styleClass="neon-label"/>
                        <TextField fx:id="tfNotes" promptText="Ex: Rythme cardiaque optimal..." prefHeight="50.0" maxWidth="Infinity" styleClass="neon-input" />
                    </VBox>
                </VBox>

                <Label fx:id="erreurLabel" textFill="#ff1744" style="-fx-font-weight: bold; -fx-font-size: 14px;" />

                <HBox spacing="30.0" alignment="CENTER">
                    <padding><Insets top="10" /></padding>
                    <children>
                        <Button onAction="#goToExercices" text="Abandonner" styleClass="btn-neon-cancel" prefHeight="45.0" prefWidth="180.0" />
                        <Button onAction="#validerAjoutCardio" text="Valider la Séquence" styleClass="btn-neon-action" prefHeight="45.0" prefWidth="220.0" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>